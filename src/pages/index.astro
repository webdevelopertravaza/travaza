    .booking-box p { color: var(--muted); }

    .bokunWidget {
      min-height: 140px;
      margin-top: 20px;
    }

    .book-number {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .13em;
      color: var(--red);
      font-weight: 800;
      margin-bottom: 10px;
    }

    .banner {
      background: var(--blue);
      color: white;
      border-radius: var(--radius);
      padding: 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
