        "contactPoint": {
          "@type": "ContactPoint",
          "email": "reservations@travaza.com",
          "contactType": "reservations and group enquiries",
          "telephone": "+1-866-979-1181",
          "availableLanguage": "English"
        }
      },
      {
        "@type": "WebPage",
        "name": "Travaza tours, tickets and trips",
        "description": "Explore Toronto and Niagara Falls tours, Ontario fall colours, Christmas outings, corporate transportation and coach bus charters.",
        "inLanguage": "en-CA",
        "about": [
          {
            "@type": "Thing",
            "name": "Niagara Falls tours from Toronto"
          },
          {
            "@type": "Thing",
