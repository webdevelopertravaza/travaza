<script is:inline>
const menu=document.querySelector('.menu'),links=document.getElementById('navlinks');menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));links.classList.toggle('open',!open);menu.textContent=open?'Menu':'Close';});links.addEventListener('click',e=>{if(e.target.closest('a')){links.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.textContent='Menu';}});
document.addEventListener('click',e=>{const a=e.target.closest('[data-destination]');if(!a)return;document.getElementById('destination').value=a.dataset.destination;if(a.dataset.interest){const field=document.getElementById('details'),interest='Interested in: '+a.dataset.interest;if(!field.value.includes(interest))field.value+=(field.value?'\n':'')+interest;}});
document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('enquiry-form').addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget;if(!form.reportValidity())return;const f=new FormData(form),labels={name:'Name',company:'Company',email:'Email',service:'Occasion',destination:'Destination',guests:'Group size',dates:'Dates',budget:'Budget',details:'Brief'};const body='Travaza group enquiry\n\n'+Object.entries(labels).map(([key,label])=>label+': '+(f.get(key)||'Not provided')).join('\n');window.location.href='mailto:reservations@travaza.com?subject='+encodeURIComponent('Travaza enquiry: '+f.get('destination'))+'&body='+encodeURIComponent(body);document.getElementById('form-status').textContent='Review and send the message in your email app. If it does not open, email reservations@travaza.com directly.';});
</script></body></html>
