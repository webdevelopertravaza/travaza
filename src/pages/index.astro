---

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Travaza creates extraordinary global travel experiences, luxury escapes, private aviation, yachts, corporate retreats, events and premium transportation."
  />

  <title>Travaza | The World, Handled.</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />

  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

</head>


<body>


<!-- ======================================================
     NAVIGATION
======================================================= -->

<nav class="nav">

  <a href="/" class="brand">
    <img
      src="/images/travaza-gold.png"
      alt="Travaza"
      class="travaza-logo"
    />
  </a>

  <div class="nav-links">
    <a href="#experiences">Experiences</a>
    <a href="#destinations">Destinations</a>
    <a href="#yachts">Yachts</a>
    <a href="#corporate">Corporate</a>
  </div>

  <a href="#plan" class="nav-button">
    Plan Your Journey
  </a>

</nav>


<!-- ======================================================
     HERO
======================================================= -->

<header class="hero">

  <div class="hero-grid">

    <div class="hero-main">
      <img
        src="/images/travaza-luxury.png"
        alt="Luxury global travel with Travaza"
      />
    </div>

    <div class="hero-small hero-top">
      <img
        src="/images/travaza-aviation.png"
        alt="Private aviation"
      />
    </div>

    <div class="hero-small hero-bottom">
      <img
        src="/images/travaza-miami.png"
        alt="Luxury destinations"
      />
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content">

      <p class="eyebrow light">
        TRAVEL WITHOUT LIMITS
      </p>

      <h1>
        The world,<br />
        <em>handled.</em>
      </h1>

      <p class="hero-copy">
        Extraordinary experiences, private journeys and seamless
        travel around the world.
      </p>

      <a href="#experiences" class="button light-button">
        Explore Travaza
      </a>

    </div>

  </div>

</header>


<!-- ======================================================
     INTRODUCTION
======================================================= -->

<section class="intro">

  <p class="eyebrow">
    TRAVAZA GLOBAL
  </p>

  <h2>
    Wherever you want to go,<br />
    <em>we make it happen.</em>
  </h2>

  <p class="intro-copy">
    Travaza is a global travel and experiences brand creating
    extraordinary journeys for individuals, families, groups and
    organizations. From a weekend escape to a multi-country itinerary,
    private aviation to a corporate retreat, we bring every element
    together into one seamless experience.
  </p>

  <p class="signature">
    Travel should feel effortless.
  </p>

</section>


<!-- ======================================================
     EXPERIENCE COLLECTION
======================================================= -->

<section id="experiences" class="collections">

  <div class="section-heading">

    <div>
      <p class="eyebrow">
        THE TRAVAZA COLLECTION
      </p>

      <h2>
        Travel designed<br />
        <em>around you.</em>
      </h2>
    </div>

    <p>
      Start with an idea. We’ll build the experience around it.
    </p>

  </div>


  <div class="collection-grid">

    {
      collections.map((item) => (

        <article class="collection-card">

          <img
            src={item.image}
            alt={item.title}
            loading="lazy"
          />

          <div class="card-overlay"></div>

          <div class="collection-content">

            <p>{item.kicker}</p>

            <h3>{item.title}</h3>

            <span>
              {item.description}
            </span>

          </div>

        </article>

      ))
    }

  </div>

</section>


<!-- ======================================================
     TRENDING
======================================================= -->

<section class="trending">

  <div class="center-heading">

    <p class="eyebrow">
      TRENDING NOW
    </p>

    <h2>
      Where the world is<br />
      <em>calling.</em>
    </h2>

  </div>


  <div class="trend-grid">

    {
      trending.map((item) => (

        <article class="trend-card">

          <div class="trend-image">

            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
            />

          </div>

          <div class="trend-content">

            <p class="eyebrow">
              {item.kicker}
            </p>

            <h3>{item.title}</h3>

            <span class="location">
              {item.location}
            </span>

            <p class="trend-description">
              {item.description}
            </p>

            <a href="#plan" class="text-link">
              Create This Experience →
            </a>

          </div>

        </article>

      ))
    }

  </div>

</section>


<!-- ======================================================
     GUYANA — DESTINATION OF THE YEAR
======================================================= -->

<section class="guyana">

  <div class="guyana-background">

    <img
      src="/images/travaza-guyana.png"
      alt="Guyana"
      loading="lazy"
    />

  </div>

  <div class="guyana-shade"></div>


  <div class="guyana-content">

    <div class="destination-year">
      DESTINATION OF THE YEAR
    </div>

    <p class="eyebrow light">
      TRAVAZA PRESENTS
    </p>

    <h2>
      Guyana
    </h2>

    <p class="guyana-lead">
      Wild. Extraordinary. Unexpected.
    </p>

    <p class="guyana-description">
      Venture beyond the familiar into one of South America's most
      remarkable destinations. Ancient rainforest, extraordinary wildlife,
      powerful waterfalls and authentic cultural experiences make Guyana
      a journey unlike anywhere else.
    </p>

    <a href="#plan" class="button light-button">
      Discover Guyana
    </a>

  </div>


  <div class="kaieteur-card">

    <img
      src="/images/kaieteur-falls.png"
      alt="Kaieteur Falls Guyana"
      loading="lazy"
    />

    <div class="kaieteur-label">
      <span>GUYANA</span>
      <strong>Kaieteur Falls</strong>
    </div>

  </div>

</section>


<!-- ======================================================
     ONE WORLD — DESTINATIONS
======================================================= -->

<section id="destinations" class="destinations">

  <div class="destination-heading">

    <p class="eyebrow gold">
      THE WORLD BY TRAVAZA
    </p>

    <h2>
      One world.<br />
      <em>Endless possibilities.</em>
    </h2>

    <p>
      From iconic capitals to remote landscapes, Travaza creates
      custom experiences around the world.
    </p>

  </div>


  <div class="destination-grid">

    {
      destinations.map((destination) => (

        <a href="#plan" class="destination-item">

          <span>{destination}</span>

          <small>EXPLORE ↗</small>

        </a>

      ))
    }

  </div>

</section>


<!-- ======================================================
     LONDON + PARIS
======================================================= -->

<section class="europe">

  <div class="europe-heading">

    <p class="eyebrow">
      EUROPE BY TRAVAZA
    </p>

    <h2>
      London<br />
      <em>to Paris.</em>
    </h2>

    <p>
      Two iconic cities. One unforgettable journey.
      Let us connect exceptional hotels, private touring,
      celebrated restaurants, shopping, theatre, culture
      and seamless transportation into one experience.
    </p>

    <a href="#plan" class="text-link">
      Design My European Escape →
    </a>

  </div>


  <div class="europe-images">

    <div class="city-photo london">

      <img
        src="/images/london.png"
        alt="London"
        loading="lazy"
      />

      <div class="city-label">
        London
      </div>

    </div>


    <div class="city-photo paris">

      <img
        src="/images/paris.png"
        alt="Paris"
        loading="lazy"
      />

      <div class="city-label">
        Paris
      </div>

    </div>

  </div>

</section>


<!-- ======================================================
     NORTH AMERICA
======================================================= -->

<section class="north-america">

  <div class="na-grid">

    <article class="na-card">

      <img
        src="/images/New-york.png"
        alt="New York"
        loading="lazy"
      />

      <div class="na-overlay"></div>

      <div class="na-copy">
        <span>USA</span>
        <h3>New York</h3>
      </div>

    </article>


    <article class="na-card">

      <img
        src="/images/miami.png"
        alt="Miami"
        loading="lazy"
      />

      <div class="na-overlay"></div>

      <div class="na-copy">
        <span>USA</span>
        <h3>Miami</h3>
      </div>

    </article>


    <article class="na-card">

      <img
        src="/images/travaza-toronto.png"
        alt="Toronto"
        loading="lazy"
      />

      <div class="na-overlay"></div>

      <div class="na-copy">
        <span>CANADA</span>
        <h3>Toronto</h3>
      </div>

    </article>

  </div>

</section>


<!-- ======================================================
     YACHT COLLECTION
======================================================= -->

<section id="yachts" class="yachts">

  <div class="yacht-image">

    <img
      src="/images/travaza-luxury.png"
      alt="Travaza Yacht Collection"
      loading="lazy"
    />

  </div>


  <div class="yacht-copy">

    <p class="eyebrow">
      THE TRAVAZA YACHT COLLECTION
    </p>

    <h2>
      Your world.<br />
      <em>from the water.</em>
    </h2>

    <p>
      Private yacht experiences created for the way you want to travel.
      From intimate escapes and celebrations to corporate entertaining
      and unforgettable days on the water.
    </p>

    <p>
      Tell us the destination, the occasion and the people you want
      beside you. We’ll help create the rest.
    </p>

    <a href="#plan" class="button dark-button">
      Explore Yacht Experiences
    </a>

  </div>

</section>


<!-- ======================================================
     CORPORATE
======================================================= -->

<section id="corporate" class="corporate">

  <div class="corporate-photo">

    <img
      src="/images/travaza-corporate.png"
      alt="Travaza corporate travel and events"
      loading="lazy"
    />

    <div class="corporate-photo-overlay"></div>

  </div>


  <div class="corporate-content">

    <p class="eyebrow gold">
      TRAVAZA FOR BUSINESS
    </p>

    <h2>
      Bring people together.<br />
      <em>We’ll handle the rest.</em>
    </h2>

    <p class="corporate-intro">
      From executive retreats to international conferences,
      Travaza brings experiences, transportation and logistics
      together under one global partner.
    </p>


    <div class="corporate-services">

      {
        corporateServices.map((service) => (

          <div class="service">
            <span>{service}</span>
            <small>↗</small>
          </div>

        ))
      }

    </div>


    <a href="#plan" class="button gold-button">
      Plan a Corporate Experience
    </a>

  </div>

</section>


<!-- ======================================================
     EVENTS
======================================================= -->

<section class="events">

  <div class="events-copy">

    <p class="eyebrow">
      EVENTS & CONFERENCES
    </p>

    <h2>
      Every detail.<br />
      <em>Every arrival.</em>
    </h2>

    <p>
      Conferences, conventions, incentive groups, corporate
      events and large-scale movements require more than transportation.
      They require coordination.
    </p>

    <p>
      Travaza can manage airport arrivals, meet and greets,
      hotel transfers, conference shuttles, private events,
      sightseeing experiences, step-on guides and group logistics.
    </p>

    <a href="#plan" class="text-link">
      Discuss Your Event →
    </a>

  </div>


  <div class="events-photo">

    <img
      src="/images/travaza-events.png"
      alt="Corporate events and conference services"
      loading="lazy"
    />

  </div>

</section>


<!-- ======================================================
     TRANSPORTATION
======================================================= -->

<section class="transportation">

  <div class="transport-bg">

    <img
      src="/images/travaza-niagara.png"
      alt="Travaza transportation"
      loading="lazy"
    />

  </div>

  <div class="transport-overlay"></div>


  <div class="transport-content">

    <p class="eyebrow light">
      TRAVAZA MOBILITY
    </p>

    <h2>
      From arrival<br />
      <em>to everywhere.</em>
    </h2>

    <p>
      Seamless transportation is part of the experience.
      From individual VIP arrivals to thousands of conference
      delegates, Travaza coordinates the journey from beginning to end.
    </p>


    <div class="transport-services">

      <span>Airport Transfers</span>

      <span>Airport Meet & Greet</span>

      <span>Private Drivers</span>

      <span>Executive Vehicles</span>

      <span>Group Shuttles</span>

      <span>Highway Coaches</span>

      <span>Conference Transportation</span>

      <span>Step-On Guides</span>

    </div>


    <a href="#plan" class="button light-button">
      Arrange Transportation
    </a>

  </div>

</section>


<!-- ======================================================
     CUSTOM EXPERIENCES
======================================================= -->

<section class="custom">

  <div class="custom-content">

    <p class="eyebrow light">
      MADE FOR YOU
    </p>

    <h2>
      Don't choose an itinerary.<br />
      <em>Create one.</em>
    </h2>

    <p>
      A private villa in Greece. Golf in Scotland. The Northern
      Lights in Iceland. A family journey through Japan.
      A corporate retreat in Canada. A yacht in the Mediterranean.
    </p>

    <p class="custom-question">
      Tell us what extraordinary looks like to you.
    </p>

    <a href="#plan" class="button light-button">
      Create My Experience
    </a>

  </div>

</section>


<!-- ======================================================
     PLAN YOUR JOURNEY
======================================================= -->

<section id="plan" class="plan">

  <div class="plan-heading">

    <p class="eyebrow">
      START SOMEWHERE
    </p>

    <h2>
      Where do you want<br />
      to go <em>next?</em>
    </h2>

    <p>
      Share a destination, an occasion or simply an idea.
      Our team will help turn it into an experience.
    </p>

  </div>


  <form
    name="travaza-experience-request"
    method="POST"
    data-netlify="true"
    class="experience-form"
  >

    <input
      type="hidden"
      name="form-name"
      value="travaza-experience-request"
    />


    <div class="form-row">

      <label>

        Name

        <input
          type="text"
          name="name"
          required
          placeholder="Your name"
        />

      </label>


      <label>

        Email

        <input
          type="email"
          name="email"
          required
          placeholder="you@email.com"
        />

      </label>

    </div>


    <div class="form-row">

      <label>

        I'm interested in

        <select name="experience">

          <option>Custom Travel Experience</option>
          <option>Golf Package</option>
          <option>Spa & Wellness</option>
          <option>Weekend Getaway</option>
          <option>Private Aviation</option>
          <option>Yacht Experience</option>
          <option>Corporate Retreat</option>
          <option>Conference Services</option>
          <option>Transportation & Shuttles</option>
          <option>Airport Meet & Greet</option>
          <option>Step-On Guide</option>

        </select>

      </label>


      <label>

        Destination

        <input
          type="text"
          name="destination"
          placeholder="Where would you like to go?"
        />

      </label>

    </div>


    <label>

      Tell us what you're imagining

      <textarea
        name="message"
        rows="5"
        placeholder="Dates, number of guests, occasion, destinations or anything else you'd like us to know..."
      ></textarea>

    </label>


    <button type="submit">
      Begin My Journey
    </button>

  </form>

</section>


<!-- ======================================================
     FOOTER
======================================================= -->

<footer>

  <img
    src="/images/travaza-gold.png"
    alt="Travaza"
    class="footer-logo"
  />

  <p class="footer-services">
    GLOBAL TRAVEL · EXPERIENCES · EVENTS · TRANSPORTATION
  </p>

  <p class="footer-tagline">
    The world, handled.
  </p>


  <div class="footer-bottom">

    <span>
      © {new Date().getFullYear()} Travaza
    </span>

    <span>
      Travel should feel effortless.
    </span>

  </div>

</footer>


<style>

/* ======================================================
   BASE
======================================================= */

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  scroll-behavior: smooth;
}

:global(body) {
  margin: 0;
  background: #f6f4ef;
  color: #161616;
  font-family: "Manrope", sans-serif;
}

:global(a) {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  width: 100%;
}

h1,
h2,
h3 {
  font-family: "Cormorant Garamond", serif;
  font-weight: 400;
}

h2 {
  margin: 0;
  font-size: clamp(48px, 6vw, 84px);
  line-height: .94;
  letter-spacing: -.02em;
}

.eyebrow {
  margin: 0 0 18px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.eyebrow.light {
  color: rgba(255,255,255,.72);
}

.eyebrow.gold,
.gold {
  color: #c5a66a;
}

.button {
  display: inline-block;
  padding: 15px 25px;
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
  transition: .25s ease;
}

.light-button {
  border: 1px solid rgba(255,255,255,.7);
  color: white;
}

.light-button:hover {
  background: white;
  color: #111;
}

.dark-button {
  border: 1px solid #171717;
}

.dark-button:hover {
  background: #171717;
  color: white;
}

.gold-button {
  border: 1px solid #c5a66a;
  color: #c5a66a;
}

.gold-button:hover {
  background: #c5a66a;
  color: #111;
}

.text-link {
  display: inline-block;
  margin-top: 22px;
  padding-bottom: 5px;
  border-bottom: 1px solid currentColor;
  font-size: 10px;
  letter-spacing: .12em;
  text-transform: uppercase;
}


/* ======================================================
   NAV
======================================================= */

.nav {
  position: absolute;
  z-index: 100;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 92px;
  padding: 15px 5vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(5,5,5,.94);
  border-bottom: 1px solid rgba(197,166,106,.3);
}

.brand {
  display: flex;
  align-items: center;
}

.travaza-logo {
  width: 190px;
  height: auto;
  max-height: 62px;
  object-fit: contain;
}

.nav-links {
  display: flex;
  gap: 35px;
  color: rgba(255,255,255,.82);
  font-size: 11px;
}

.nav-links a {
  transition: color .2s ease;
}

.nav-links a:hover {
  color: #c5a66a;
}

.nav-button {
  padding: 12px 18px;
  border: 1px solid #c5a66a;
  color: #c5a66a;
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
}


/* ======================================================
   HERO
======================================================= */

.hero {
  background: #090909;
  color: white;
}

.hero-grid {
  position: relative;
  min-height: 96vh;
  padding-top: 92px;
  display: grid;
  grid-template-columns: 1.4fr .72fr;
  grid-template-rows: 1fr 1fr;
  gap: 3px;
  overflow: hidden;
}

.hero-main {
  grid-row: 1 / 3;
}

.hero-main,
.hero-small {
  overflow: hidden;
}

.hero-main img,
.hero-small img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  inset: 92px 0 0;
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.75) 0%,
      rgba(0,0,0,.45) 35%,
      rgba(0,0,0,.06) 72%
    );
}

.hero-content {
  position: absolute;
  z-index: 5;
  left: 7vw;
  bottom: 10vh;
  max-width: 750px;
}

.hero-content h1 {
  margin: 0;
  font-size: clamp(78px, 10vw, 145px);
  line-height: .76;
  letter-spacing: -.04em;
}

.hero-copy {
  max-width: 500px;
  margin: 35px 0;
  font-size: 17px;
  line-height: 1.7;
  color: rgba(255,255,255,.83);
