];
const grid=document.getElementById('destination-grid'),dialog=document.getElementById('destination-dialog');let lastTrigger;
for(const d of destinations){const b=document.createElement('button');b.type='button';b.className='destination';b.setAttribute('aria-label','Explore '+d.name);b.innerHTML=`<div class="photo"><img src="${images[d.image]}" alt="${d.alt}" width="700" height="500" loading="lazy"></div><div class="caption"><h3>${d.name}</h3><span class="arrow" aria-hidden="true">↗</span></div><div class="region">${d.region}</div>`;b.addEventListener('click',()=>{lastTrigger=b;document.getElementById('dialog-title').textContent=d.name;document.getElementById('dialog-region').textContent=d.region;document.getElementById('dialog-description').textContent=d.description;const img=document.getElementById('dialog-image');img.src=images[d.image];img.alt=d.alt;document.getElementById('dialog-enquire').dataset.destination=d.name;dialog.showModal()});grid.append(b)}
dialog.querySelector('.close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});dialog.addEventListener('close',()=>lastTrigger?.focus());
const menu=document.querySelector('.menu'),nav=document.getElementById('navigation');menu.addEventListener('click',()=>{const opened=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!opened));nav.classList.toggle('open',!opened);menu.textContent=opened?'Menu':'Close'});nav.addEventListener('click',e=>{if(e.target.closest('a')){menu.setAttribute('aria-expanded','false');nav.classList.remove('open');menu.textContent='Menu'}});
document.addEventListener('click',e=>{const a=e.target.closest('[data-destination]');if(!a)return;document.getElementById('destination').value=a.dataset.destination;if(dialog.open)dialog.close()});
document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('enquiry-form').addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget;if(!form.reportValidity())return;const f=new FormData(form);const body=['Travaza group & event enquiry','',...['name','company','email','phone','service','destination','dates','guests','details'].map(k=>({name:'Name',company:'Company',email:'Email',phone:'Phone',service:'Service',destination:'Destination',dates:'Dates',guests:'Group size',details:'Vision & requirements'}[k]+': '+(f.get(k)||'Not provided')))].join('\n');const href='mailto:reservations@travaza.com?subject='+encodeURIComponent('Travaza enquiry — '+f.get('destination')+' / '+f.get('service'))+'&body='+encodeURIComponent(body);window.location.href=href;const status=document.getElementById('form-status');status.textContent='Your email app has been requested. Your enquiry is only sent when you press Send in that app. You can also email reservations@travaza.com directly.'});
</script>
</body></html>
