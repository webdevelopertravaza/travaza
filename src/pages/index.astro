    }

    .departure {
      background: var(--pale);
      border-radius: 10px;
      padding: 13px 15px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .departure strong {
      display: block;
      color: var(--blue);
    }

    .book-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      flex-wrap: wrap;
    }

    .booking-box {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px;
      margin: 26px 0;
      box-shadow: 0 10px 35px #08264d06;
