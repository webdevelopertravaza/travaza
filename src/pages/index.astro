<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Travaza | Toronto Tours, Niagara Falls &amp; Trips Beyond</title>
  <meta name="description" content="Explore Toronto city tours, Niagara Falls tours from Toronto, attraction tickets and monthly trips with Travaza. Enquire about New York City and Guyana travel.">
  <meta name="theme-color" content="#123b36">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Travaza | Toronto Tours & Trips Beyond">
  <meta property="og:description" content="Big views. Memorable days. Find Toronto and Niagara Falls tours, attraction tickets and your next adventure.">

  <style>
    :root {
      --ink: #163832;
      --muted: #536760;
      --green: #123b36;
      --cream: #f8f7f2;
      --lime: #e3f4a5;
      --line: #dce3dc;
      --white: #fff;
      --orange: #ffca9d;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 100px;
    }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font: 16px/1.65 system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
    }

    a { color: inherit; }

    button, input, select, textarea { font: inherit; }

    button, a, input, select, textarea {
      touch-action: manipulation;
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    summary:focus-visible {
      outline: 3px solid #dc6c30;
      outline-offset: 4px;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1, h2, h3 {
      line-height: 1.12;
      letter-spacing: -.035em;
    }

    h1 {
      font-size: clamp(44px, 6.5vw, 82px);
      max-width: 780px;
      margin-bottom: 24px;
    }

    h2 {
      font-size: clamp(30px, 4vw, 46px);
      margin-bottom: 16px;
    }

    h3 {
      font-size: 25px;
      margin-bottom: 14px;
    }

    .wrap {
      max-width: 1200px;
      margin: auto;
      padding: 0 28px;
    }

    .small { font-size: 14px; }
    .muted { color: var(--muted); }

    .eyebrow {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 12px 22px;
      border: 1px solid transparent;
      border-radius: 100px;
      text-decoration: none;
      font-weight: 750;
      cursor: pointer;
      background: var(--green);
      color: white;
    }

    .btn:hover { background: #25564c; }

    .btn.light {
      background: var(--lime);
      color: var(--ink);
    }

    .btn.light:hover { background: #d4ec83; }

    .btn.outline {
      background: transparent;
      border-color: var(--line);
      color: var(--ink);
    }

    .actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .pill {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 50px;
      background: #eaf0e8;
      font-size: 12px;
      font-weight: 750;
    }

    .section { padding: 76px 0; }

    .section-head {
      max-width: 750px;
      margin-bottom: 30px;
    }

    .section-head p {
      font-size: 18px;
      color: var(--muted);
    }

    .grid {
      display: grid;
      gap: 22px;
    }

    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 22px;
      overflow: hidden;
    }

    .card-body { padding: 26px; }
    .card p { color: var(--muted); }

    .card ul {
      padding-left: 20px;
      color: var(--muted);
      margin-bottom: 24px;
    }

    .card .btn { width: 100%; }

    .card-art {
      height: 160px;
      display: flex;
      align-items: flex-end;
      padding: 24px;
      background: #d7e9ec;
      position: relative;
      overflow: hidden;
    }

    .card-art span {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      z-index: 1;
      background: white;
      padding: 6px 12px;
      border-radius: 50px;
    }

    .falls {
      background: linear-gradient(155deg, #badedb, #e4f2ea);
    }

    .city {
      background: linear-gradient(155deg, #f3d7bc, #faebd7);
    }

    .tickets {
      background: linear-gradient(155deg, #dfd8ef, #f2eafa);
    }

    .card-art:after {
      content: "";
      position: absolute;
      width: 220px;
      height: 220px;
      border: 28px solid #ffffff80;
      border-radius: 50%;
      right: -42px;
      top: -85px;
    }

    .note {
      padding: 18px 22px;
      border-radius: 14px;
      background: #edf2e6;
    }

    .booking-box {
      background: white;
      border: 1px solid var(--line);
      padding: 26px;
      border-radius: 22px;
      margin: 24px 0;
    }

    .booking-box h3 { font-size: 23px; }
    .bokunWidget { min-height: 120px; }

    .booking-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .booking-links a { text-underline-offset: 4px; }

    .trip-card { padding: 32px; }
    .trip-card .pill { margin-bottom: 20px; }
    .trip-card h3 { font-size: 34px; }
    .trip-card .btn { width: auto; }

    .destinations {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .destination {
      padding: 13px 19px;
      background: white;
      border: 1px solid var(--line);
      border-radius: 12px;
      text-decoration: none;
    }

    .destination:hover { border-color: var(--green); }

    .faq details {
      border-bottom: 1px solid var(--line);
      padding: 20px 0;
    }

    .faq summary {
      cursor: pointer;
      font-weight: 750;
    }

    .faq details p {
      margin: 14px 0 0;
      color: var(--muted);
    }

    .topbar {
      background: var(--green);
      color: #fff;
      text-align: center;
      padding: 8px 20px;
      font-size: 12px;
      letter-spacing: .05em;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: #f8f7f2f5;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 82px;
    }

    .logo {
      text-decoration: none;
      font-size: 30px;
      font-weight: 850;
      letter-spacing: -.06em;
    }

    .logo span { color: #bd682f; }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
    }

    .nav-links a {
      text-decoration: none;
      font-size: 14px;
      font-weight: 650;
    }

    .menu-toggle {
      display: none;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 9px 14px;
      color: var(--ink);
    }

    .hero {
      padding: 82px 0 72px;
      background: var(--green);
      color: #fff;
      overflow: hidden;
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 44px;
      align-items: center;
    }

    .hero p {
      color: #d9e7dc;
      max-width: 610px;
      font-size: 18px;
    }

    .hero .eyebrow {
      color: var(--lime);
      font-size: 12px;
    }

    .hero .btn.outline {
      color: white;
      border-color: #79988e;
    }

    .hero-art {
      min-height: 345px;
      border-radius: 180px 180px 22px 22px;
      background: linear-gradient(
        150deg, #b7d6b9, #e5f2ac 60%, #f7ca9d
      );
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 25px;
      overflow: hidden;
    }

    .hero-art svg {
      position: absolute;
      bottom: 58px;
      width: 100%;
      height: 240px;
    }

    .hero-art p {
      position: relative;
      margin: 0;
      color: var(--green);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .06em;
    }

    .quick-links {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .quick-links a {
      color: #e6eee8;
      font-size: 14px;
      text-underline-offset: 5px;
    }

    .strip {
      border-bottom: 1px solid var(--line);
      background: white;
    }

    .strip .wrap {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding-top: 18px;
      padding-bottom: 18px;
      font-size: 14px;
      font-weight: 650;
    }

    .tinted { background: #edf1e9; }

    .contact {
      background: var(--green);
      color: white;
    }

    .contact .muted,
    .contact p { color: #d4e3da; }

    .contact h2 { max-width: 470px; }

    .contact a {
      color: var(--lime);
      overflow-wrap: anywhere;
    }

    .contact-form {
      background: white;
      color: var(--ink);
      border-radius: 22px;
      padding: 28px;
    }

    .contact-form p { color: var(--muted); }

    .contact-form label {
      display: block;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .field { margin-bottom: 17px; }

    .contact-form input,
    .contact-form select,
    .contact-form textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #bdcbc0;
      border-radius: 9px;
      background: white;
      color: var(--ink);
    }

    .contact-form textarea {
      min-height: 110px;
      resize: vertical;
    }

    .contact-form .btn { width: 100%; }

    .footer {
      background: #0c2925;
      color: #e4ede7;
      padding: 44px 0 22px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 32px;
    }

    .footer h3 {
      font-size: 15px;
      letter-spacing: 0;
    }

    .footer p {
      font-size: 14px;
      color: #bed1c6;
      max-width: 400px;
    }

    .footer a {
      display: block;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 9px;
    }

    .footer .logo { font-size: 29px; }

    .footer-bottom {
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid #38554b;
      font-size: 12px;
      color: #bed1c6;
    }

    @media (max-width: 900px) {
      .hero-layout { grid-template-columns: 1fr; }
      .hero-art { display: none; }
      .three { grid-template-columns: 1fr; }

      .card {
        display: grid;
        grid-template-columns: 180px 1fr;
      }

      .card-art {
        height: 100%;
        min-height: 180px;
      }

      .nav-links { gap: 14px; }
      .strip .wrap { flex-wrap: wrap; }

      .footer-grid { grid-template-columns: 1fr 1fr; }

      .footer-grid > div:first-child {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 650px) {
      .wrap { padding: 0 20px; }
      .section { padding: 50px 0; }
      .hero { padding: 55px 0; }
      .two { grid-template-columns: 1fr; }
      .card { display: block; }

      .card-art {
        height: 125px;
        min-height: 125px;
      }

      .menu-toggle { display: block; }

      .nav {
        min-height: 72px;
        flex-wrap: wrap;
      }

      .nav-links {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        padding-bottom: 18px;
      }

      .header.enhanced .nav-links { display: none; }

      .header.enhanced .nav-links.is-open {
        display: flex;
      }

      .nav-links .btn {
        min-height: 40px;
        padding: 7px 15px;
      }

      .strip .wrap {
        font-size: 12px;
        gap: 10px 20px;
      }

      .booking-box { padding: 20px 14px; }
      .trip-card { padding: 25px; }
      .footer-grid { gap: 25px; }
      .contact-form { padding: 22px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>

