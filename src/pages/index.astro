---

<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Travaza | Luxury Travel, Global Transportation & Curated Experiences
  </title>

  <meta
    name="description"
    content="Travaza is a global travel and transportation company specializing in luxury experiences, corporate transportation, events, private aviation, yacht charters, worldwide coach transportation and curated travel."
  />

  <meta
    name="keywords"
    content="luxury travel, private jet charter, yacht charter, worldwide coach charter, corporate transportation, Niagara Falls private tours, Toronto transportation, Miami yacht charter, Guyana tours, event transportation"
  />

  <style>
    :root {
      --black: #050706;
      --black-soft: #0b0d0c;
      --black-card: #101311;

      --cream: #f5f1e7;
      --cream-soft: #ebe5d9;

      --gold: #cf9b35;
      --gold-light: #edc675;
      --gold-muted: #a77b2a;

      --white: #fff;
      --text-light: rgba(255,255,255,.82);
      --text-muted: rgba(255,255,255,.56);

      --dark-text: #161917;
      --dark-muted: #686c68;

      --line-light: rgba(255,255,255,.12);
      --line-dark: rgba(20,24,21,.13);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--black);
      color: var(--white);
      font-family:
        "Helvetica Neue",
        Helvetica,
        Arial,
        sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    input,
    textarea,
    select,
    button {
      font: inherit;
    }

    .container {
      width: min(1200px, calc(100% - 42px));
      margin: 0 auto;
    }

    .eyebrow {
      color: var(--gold);
      font-weight: 700;
      font-size: 11px;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    .display-heading {
      font-size: clamp(44px, 6.5vw, 82px);
      font-weight: 300;
      letter-spacing: -.045em;
      line-height: .98;
      margin: 14px 0 20px;
    }

    .section-copy {
      max-width: 690px;
      color: var(--text-muted);
      line-height: 1.7;
      font-size: 17px;
    }


    /* HEADER */

    header {
      position: absolute;
      width: 100%;
      z-index: 20;
      border-bottom: 1px solid var(--line-light);
    }

    .nav {
      min-height: 92px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      width: 190px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links a {
      color: rgba(255,255,255,.74);
      font-size: 11px;
      letter-spacing: .12em;
      text-transform: uppercase;
      transition: .2s;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    .nav-button {
      border: 1px solid rgba(207,155,53,.8);
      padding: 13px 18px;
      color: var(--gold-light) !important;
    }


    /* HERO */

    .hero {
      min-height: 880px;
      position: relative;
      display: flex;
      align-items: center;

      background:
        radial-gradient(
          circle at 83% 35%,
          rgba(207,155,53,.13),
          transparent 28%
        ),
        linear-gradient(
          120deg,
          #030504,
          #0b0e0c 65%,
          #121109
        );

      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: 160px;
      right: -220px;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      border: 1px solid rgba(207,155,53,.16);
    }

    .hero::after {
      content: "";
      position: absolute;
      top: 240px;
      right: -130px;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      border: 1px solid rgba(207,155,53,.08);
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      padding-top: 100px;
      max-width: 950px;
    }

    .hero h1 {
      font-size: clamp(62px, 9.4vw, 126px);
      line-height: .87;
      letter-spacing: -.065em;
      font-weight: 200;
      margin: 25px 0 30px;
    }

    .hero h1 .gold {
      color: var(--gold);
    }

    .hero-description {
      max-width: 770px;
      color: rgba(255,255,255,.69);
      line-height: 1.62;
      font-size: clamp(18px, 2vw, 23px);
    }

    .hero-actions {
      margin-top: 38px;
      display: flex;
      gap: 13px;
      flex-wrap: wrap;
    }

    .btn {
      min-height: 54px;
      padding: 0 25px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: .13em;
      font-weight: 700;
      cursor: pointer;
      border: none;
    }

    .btn-gold {
      background: var(--gold);
      color: #060806;
    }

    .btn-gold:hover {
      background: var(--gold-light);
    }

    .btn-outline {
      border: 1px solid rgba(255,255,255,.25);
      color: white;
    }

    .btn-outline:hover {
      border-color: var(--gold);
      color: var(--gold-light);
    }

    .hero-bottom {
      margin-top: 75px;
      padding-top: 27px;
      border-top: 1px solid var(--line-light);

      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
    }

    .hero-stat strong {
      display: block;
      color: var(--gold-light);
      font-weight: 400;
      font-size: 16px;
      margin-bottom: 7px;
    }

    .hero-stat span {
      color: rgba(255,255,255,.5);
      font-size: 12px;
      line-height: 1.5;
    }


    /* WHO WE ARE */

    .who {
      padding: 120px 0;
      background: var(--cream);
      color: var(--dark-text);
    }

    .who-grid {
      display: grid;
      grid-template-columns: .72fr 1.28fr;
      gap: 100px;
    }

    .who .display-heading {
      color: var(--dark-text);
    }

    .who-copy {
      font-size: 18px;
      line-height: 1.82;
      color: #555a55;
    }

    .who-copy strong {
      color: var(--dark-text);
      font-weight: 600;
    }

    .promise {
      margin-top: 30px;
      padding-top: 25px;
      border-top: 1px solid var(--line-dark);
      font-size: 24px;
      line-height: 1.4;
      color: var(--dark-text);
      font-weight: 300;
    }


    /* WHAT WE DO */

    .what {
      padding: 120px 0;
    }

    .division-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      margin-top: 55px;
      border-top: 1px solid var(--line-light);
      border-left: 1px solid var(--line-light);
    }

    .division {
      min-height: 510px;
      padding: 42px;
      border-right: 1px solid var(--line-light);
      border-bottom: 1px solid var(--line-light);
      display: flex;
      flex-direction: column;
    }

    .division img {
      width: 215px;
      height: 75px;
      object-fit: contain;
      object-position: left center;
    }

    .division h3 {
      margin: auto 0 12px;
      font-size: 36px;
      font-weight: 300;
      letter-spacing: -.03em;
    }

    .division > p {
      color: var(--text-muted);
      line-height: 1.65;
      font-size: 15px;
      max-width: 520px;
    }

    .mini-services {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 22px;
    }

    .mini-service {
      border: 1px solid var(--line-light);
      padding: 9px 11px;
      font-size: 11px;
      color: rgba(255,255,255,.62);
    }


    /* DESTINATIONS */

    .where {
      padding: 120px 0;
      background: var(--cream);
      color: var(--dark-text);
    }

    .where .section-copy {
      color: var(--dark-muted);
    }

    .destination-list {
      margin-top: 55px;
      border-top: 1px solid var(--line-dark);
    }

    .destination-row {
      display: grid;
      grid-template-columns: 170px 1fr 1.2fr;
      gap: 50px;
      align-items: center;

      padding: 45px 0;
      border-bottom: 1px solid var(--line-dark);
    }

    .destination-row img {
      max-width: 150px;
      max-height: 65px;
      object-fit: contain;
      object-position: left center;
    }

    .destination-region {
      color: var(--gold-muted);
      font-size: 10px;
      letter-spacing: .16em;
      font-weight: 700;
    }

    .destination-row h3 {
      margin: 7px 0 8px;
      font-size: 32px;
      font-weight: 300;
    }

    .destination-row .headline {
      color: var(--dark-text);
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .destination-row p {
      color: var(--dark-muted);
      line-height: 1.65;
      margin: 0;
      font-size: 14px;
    }


    /* SIGNATURE EXPERIENCES */

    .signature {
      padding: 120px 0;
    }

    .signature-grid {
      margin-top: 50px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--line-light);
      border: 1px solid var(--line-light);
    }

    .signature-card {
      min-height: 330px;
      background: var(--black);
      padding: 34px;
      display: flex;
      flex-direction: column;
    }

    .signature-card h3 {
      margin: auto 0 13px;
      font-size: 28px;
      font-weight: 300;
      line-height: 1.15;
    }

    .signature-card p {
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 14px;
      margin-bottom: 0;
    }


    /* GLOBAL MOVEMENT */

    .movement {
      padding: 120px 0;
      background: #0d100e;
    }

    .movement-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 95px;
    }

    .movement h2 {
      font-size: clamp(43px, 5vw, 68px);
      font-weight: 300;
      line-height: 1.02;
      letter-spacing: -.04em;
      margin: 13px 0 25px;
    }

    .movement-copy {
      color: var(--text-muted);
      font-size: 17px;
      line-height: 1.75;
    }

    .movement-services {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      border-top: 1px solid var(--line-light);
    }

    .movement-item {
      padding: 17px 5px;
      border-bottom: 1px solid var(--line-light);
      color: rgba(255,255,255,.76);
      font-size: 14px;
    }

    .movement-item::before {
      content: "—";
      color: var(--gold);
      margin-right: 12px;
    }


    /* CLOSING STATEMENT */

    .statement {
      padding: 135px 0;
      background: var(--cream);
      color: var(--dark-text);
      text-align: center;
    }

    .statement-inner {
      max-width: 900px;
      margin: auto;
    }

    .statement blockquote {
      margin: 20px 0 0;
      font-size: clamp(38px, 5vw, 67px);
      line-height: 1.08;
      letter-spacing: -.04em;
      font-weight: 300;
    }

    .statement blockquote span {
      color: var(--gold-muted);
    }


    /* FORM */

    .contact {
      padding: 120px 0;
      background: var(--black);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: .75fr 1.25fr;
      gap: 90px;
    }

    .contact h2 {
      font-size: clamp(44px, 5vw, 68px);
      font-weight: 300;
      letter-spacing: -.04em;
      line-height: 1.02;
      margin: 14px 0 22px;
    }

    .contact-copy {
      color: var(--text-muted);
      line-height: 1.7;
      font-size: 17px;
    }

    .direct-contact {
      margin-top: 35px;
      padding-top: 25px;
      border-top: 1px solid var(--line-light);
      color: rgba(255,255,255,.57);
      line-height: 1.8;
    }

    .direct-contact a {
      color: var(--gold-light);
    }

    .quote-form {
      background: white;
      color: var(--dark-text);
      padding: 42px;
    }

    .quote-form h3 {
      margin: 0 0 27px;
      font-size: 27px;
      font-weight: 300;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field-full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #626662;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid #d9dbd8;
      background: #faf9f6;
      color: #151815;
      min-height: 51px;
      padding: 12px 13px;
      outline: none;
      border-radius: 0;
    }

    textarea {
      min-height: 135px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--gold);
    }

    .submit {
      width: 100%;
      margin-top: 20px;
      min-height: 58px;
      background: var(--black);
      border: none;
      color: white;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .submit:hover {
      color: var(--gold-light);
    }

    .form-note {
      font-size: 11px;
      color: #767a76;
      margin-top: 14px;
      line-height: 1.5;
    }


    /* FOOTER */

    footer {
      padding: 65px 0 35px;
      background: #020302;
      border-top: 1px solid var(--line-light);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.3fr .7fr .7fr;
      gap: 60px;
    }

    .footer-logo {
      width: 205px;
      margin-bottom: 20px;
    }

    .footer-copy {
      max-width: 450px;
      color: rgba(255,255,255,.48);
      line-height: 1.65;
      font-size: 13px;
    }

    .footer-heading {
      color: var(--gold);
      letter-spacing: .14em;
      font-size: 10px;
      margin-bottom: 17px;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 11px;
      color: rgba(255,255,255,.61);
      font-size: 13px;
    }

    .legal {
      margin-top: 55px;
      padding-top: 23px;
      border-top: 1px solid var(--line-light);
      font-size: 10px;
      color: rgba(255,255,255,.35);
      line-height: 1.6;
    }


    /* MOBILE */

    @media (max-width: 900px) {

      .nav-links a:not(.nav-button) {
        display: none;
      }

      .who-grid,
      .movement-grid,
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 50px;
      }

      .division-grid {
        grid-template-columns: 1fr;
      }

      .signature-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .destination-row {
        grid-template-columns: 130px 1fr;
      }

      .destination-row > div:last-child {
        grid-column: 2;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-grid > div:first-child {
        grid-column: 1 / -1;
      }
    }


    @media (max-width: 640px) {

      .container {
        width: calc(100% - 28px);
      }

      .nav {
        min-height: 76px;
      }

      .logo {
        width: 150px;
      }

      .nav-button {
        padding: 10px 12px !important;
      }

      .hero {
        min-height: 790px;
      }

      .hero-inner {
        padding-top: 110px;
      }

      .hero-bottom {
        grid-template-columns: repeat(2, 1fr);
      }

      .who,
      .what,
      .where,
      .signature,
      .movement,
      .statement,
      .contact {
        padding: 80px 0;
      }

      .division {
        min-height: 440px;
        padding: 28px;
      }

      .signature-grid {
        grid-template-columns: 1fr;
      }

      .destination-row {
        grid-template-columns: 1fr;
        gap: 15px;
        padding: 35px 0;
      }

      .destination-row > div:last-child {
        grid-column: auto;
      }

      .movement-services {
        grid-template-columns: 1fr;
      }

      .quote-form {
        padding: 27px 18px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .field-full {
        grid-column: auto;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid > div:first-child {
        grid-column: auto;
      }
    }
  </style>

</head>


<body>


<!-- HEADER -->

<header>
  <div class="container nav">

    <a href="/">
      <img
        class="logo"
        src="/images/travaza/travaza-gold.png"
        alt="Travaza"
      />
    </a>

    <nav class="nav-links">
      <a href="#who">Who We Are</a>
      <a href="#what">What We Do</a>
      <a href="#where">Destinations</a>
      <a href="#experiences">Experiences</a>
      <a href="#contact" class="nav-button">
        Start Planning
      </a>
    </nav>

  </div>
</header>


<main>


<!-- HERO -->

<section class="hero">

  <div class="container hero-inner">

    <div class="eyebrow">
      TRAVEL • TRANSPORTATION • EXPERIENCES
    </div>

    <h1>
      Travel,
      <br />
      <span class="gold">elevated.</span>
    </h1>

    <p class="hero-description">
      Travaza brings together luxury travel, global transportation,
      private aviation, yachts, curated experiences and complex
      group movements through one trusted relationship.
    </p>

    <div class="hero-actions">

      <a href="#contact" class="btn btn-gold">
        Start Planning
      </a>

      <a href="#what" class="btn btn-outline">
        Discover Travaza
      </a>

    </div>


    <div class="hero-bottom">

      <div class="hero-stat">
        <strong>Global Transportation</strong>
        <span>From individual travellers to major movements.</span>
      </div>

      <div class="hero-stat">
        <strong>Curated Experiences</strong>
        <span>Built around the traveller, not a template.</span>
      </div>

      <div class="hero-stat">
        <strong>Luxury & Aviation</strong>
        <span>Yachts, private aircraft and high-touch travel.</span>
      </div>

      <div class="hero-stat">
        <strong>One Relationship</strong>
        <span>Planning, logistics and execution together.</span>
      </div>

    </div>

  </div>

</section>



<!-- WHO WE ARE -->

<section
  id="who"
  class="who"
>

  <div class="container who-grid">

    <div>

      <div class="eyebrow">
        WHO WE ARE
      </div>

      <h2 class="display-heading">
        One company.
        A world of possibilities.
      </h2>

    </div>


    <div class="who-copy">

      <p>
        Travaza is a global travel, transportation and experience
        company built for travellers and organizations that expect
        more than a reservation.
      </p>

      <p>
        We combine
        <strong>
          transportation, destination expertise, touring,
          private aviation, yachts, guides, events and logistics
        </strong>
        into thoughtfully coordinated journeys.
      </p>

      <p>
        Our clients range from individual travellers and families
        to corporations, tour operators, sports organizations,
        musicians, schools, event planners and major groups.
      </p>

      <div class="promise">
        You tell us where you need to go.
        We bring the pieces together.
      </div>

    </div>

  </div>

</section>



<!-- WHAT WE DO -->

<section
  id="what"
  class="what"
>

  <div class="container">

    <div class="eyebrow">
      WHAT WE DO
    </div>

    <h2 class="display-heading">
      Travel is complicated.
      <br />
      We make it feel simple.
    </h2>

    <p class="section-copy">
      Travaza operates across complementary travel disciplines,
      allowing one team to coordinate more of the journey and
      create a more seamless experience.
    </p>


    <div class="division-grid">

      {
        divisions.map((division) => (

          <article class="division">

            <img
              src={division.image}
              alt={division.label}
            />

            <h3>
              {division.name}
            </h3>

            <p>
              {division.description}
            </p>

            <div class="mini-services">

              {
                division.services.map((service) => (

                  <span class="mini-service">
                    {service}
                  </span>

                ))
              }

            </div>

          </article>

        ))
      }

    </div>

  </div>

</section>



<!-- WHERE WE OPERATE -->

<section
  id="where"
  class="where"
>

  <div class="container">

    <div class="eyebrow">
      WHERE WE GO
    </div>

    <h2 class="display-heading">
      Local knowledge.
      Global ambition.
    </h2>

    <p class="section-copy">
      We build deep destination expertise in key markets
      while coordinating transportation and travel solutions
      around the world.
    </p>


    <div class="destination-list">

      {
        destinations.map((destination) => (

          <article class="destination-row">

            <img
              src={destination.image}
              alt={`Travaza ${destination.name}`}
            />


            <div>

              <div class="destination-region">
                {destination.region}
              </div>

              <h3>
                {destination.name}
              </h3>

            </div>


            <div>

              <div class="headline">
                {destination.headline}
              </div>

              <p>
                {destination.description}
              </p>

            </div>

          </article>

        ))
      }

    </div>

  </div>

</section>



<!-- SIGNATURE EXPERIENCES -->

<section
  id="experiences"
  class="signature"
>

  <div class="container">

    <div class="eyebrow">
      SIGNATURE EXPERIENCES
    </div>

    <h2 class="display-heading">
      Go beyond the itinerary.
    </h2>

    <p class="section-copy">
      Some journeys begin with a destination.
      Others begin with an idea.
      We design around both.
    </p>


    <div class="signature-grid">

      {
        signatureExperiences.map((experience) => (

          <article class="signature-card">

            <div class="eyebrow">
              {experience.eyebrow}
            </div>

            <h3>
              {experience.title}
            </h3>

            <p>
              {experience.description}
            </p>

          </article>

        ))
      }

    </div>

  </div>

</section>



<!-- WORLDWIDE TRANSPORTATION -->

<section class="movement">

  <div class="container movement-grid">

    <div>

      <div class="eyebrow">
        TRAVAZA MOVEMENT
      </div>

      <h2>
        Moving people is easy.
        Moving them well is different.
      </h2>

      <p class="movement-copy">
        Travaza coordinates transportation programs around
        the itinerary rather than forcing the itinerary
        around transportation.
      </p>

      <p class="movement-copy">
        One coach or an entire fleet.
        One airport arrival or a multi-day movement.
        One destination or multiple countries.
      </p>

      <a
        href="#contact"
        class="btn btn-gold"
      >
        Request Transportation
      </a>

    </div>


    <div class="movement-services">

      {
        movementServices.map((service) => (

          <div class="movement-item">
            {service}
          </div>

        ))
      }

    </div>

  </div>

</section>



<!-- BRAND STATEMENT -->

<section class="statement">

  <div class="container statement-inner">

    <div class="eyebrow">
      THE TRAVAZA APPROACH
    </div>

    <blockquote>
      Not simply where you go.
      <br />
      <span>
        How you experience getting there.
      </span>
    </blockquote>

  </div>

</section>



<!-- CONTACT -->

<section
  id="contact"
  class="contact"
>

  <div class="container contact-grid">

    <div>

      <div class="eyebrow">
        START YOUR JOURNEY
      </div>

      <h2>
        Tell us what you're planning.
      </h2>

      <p class="contact-copy">
        Whether you're planning a private journey,
        corporate movement, event, tour, yacht,
        aviation charter or worldwide transportation program,
        our team can help bring the pieces together.
      </p>

      <div class="direct-contact">

        Reservations & Travel Planning
        <br />

        <a href="mailto:reservations@travaza.com">
          reservations@travaza.com
        </a>

      </div>

    </div>


    <form
      class="quote-form"
      name="travaza-charter-request"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you"
    >

      <input
        type="hidden"
        name="form-name"
        value="travaza-charter-request"
      />

      <p style="display:none;">
        <label>
          Do not fill:
          <input name="bot-field" />
        </label>
      </p>


      <h3>
        Request a Proposal
      </h3>


      <div class="form-grid">

        <div class="field">

          <label for="name">
            Name *
          </label>

          <input
            id="name"
            name="name"
            type="text"
            required
          />

        </div>


        <div class="field">

          <label for="company">
            Company / Organization
          </label>

          <input
            id="company"
            name="company"
            type="text"
          />

        </div>


        <div class="field">

          <label for="email">
            Email *
          </label>

          <input
            id="email"
            name="email"
            type="email"
            required
          />

        </div>


        <div class="field">

          <label for="phone">
            Phone
          </label>

          <input
            id="phone"
            name="phone"
            type="tel"
          />

        </div>


        <div class="field field-full">

          <label for="service">
            What are you planning? *
          </label>

          <select
            id="service"
            name="service"
            required
          >

            <option value="">
              Select
            </option>

            <option>
              Coach Charter
            </option>

            <option>
              Corporate Transportation
            </option>

            <option>
              Event Transportation
            </option>

            <option>
              Sports Team Transportation
            </option>

            <option>
              Musician / Touring Production
            </option>

            <option>
              Private Tour
            </option>

            <option>
              Custom Travel Package
            </option>

            <option>
              Private Yacht
            </option>

            <option>
              Private Jet Charter
            </option>

            <option>
              Airport Transfer
            </option>

            <option>
              Group Movement
            </option>

            <option>
              Step-On Guide
            </option>

            <option>
              Other
            </option>

          </select>

        </div>


        <div class="field">

          <label for="date">
            Date
          </label>

          <input
            id="date"
            name="date"
            type="date"
          />

        </div>


        <div class="field">

          <label for="passengers">
            Number of Guests
          </label>

          <input
            id="passengers"
            name="passengers"
            type="number"
            min="1"
          />

        </div>


        <div class="field">

          <label for="origin">
            Starting Location
          </label>

          <input
            id="origin"
            name="starting_location"
            type="text"
          />

        </div>


        <div class="field">

          <label for="destination">
            Destination
          </label>

          <input
            id="destination"
            name="destination"
            type="text"
          />

        </div>


        <div class="field field-full">

          <label for="details">
            Tell Us About Your Plans
          </label>

          <textarea
            id="details"
            name="details"
            placeholder="Dates, destinations, flight details, hotel, stops, vehicle requirements, experiences, itinerary ideas or anything else we should know."
          ></textarea>

        </div>

      </div>


      <button
        class="submit"
        type="submit"
      >
        Send Request to Travaza
      </button>


      <div class="form-note">
        Submission is a request for availability and does not constitute a confirmed reservation.
      </div>

    </form>

  </div>

</section>


</main>



<!-- FOOTER -->

<footer>

  <div class="container">

    <div class="footer-grid">

      <div>

        <img
          class="footer-logo"
          src="/images/travaza/travaza-gold.png"
          alt="Travaza"
        />

        <p class="footer-copy">
          Global transportation, luxury travel and curated
          experiences designed around people, place and purpose.
        </p>

      </div>


      <div>

        <div class="footer-heading">
          TRAVAZA
        </div>

        <div class="footer-links">
          <a href="#who">Who We Are</a>
          <a href="#what">What We Do</a>
          <a href="#where">Destinations</a>
          <a href="#experiences">Experiences</a>
        </div>

      </div>


      <div>

        <div class="footer-heading">
          CONTACT
        </div>

        <div class="footer-links">

          <a href="#contact">
            Request a Proposal
          </a>

          <a href="mailto:reservations@travaza.com">
            reservations@travaza.com
          </a>

        </div>

      </div>

    </div>


    <div class="legal">
      © {new Date().getFullYear()} Travaza.
      Services are subject to destination availability,
      supplier terms, regulatory requirements and final confirmation.
    </div>

  </div>

</footer>


</body>
</html>
