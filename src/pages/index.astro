---
const audiences = [
  "Private Clients",
  "Family Offices",
  "Professional Sports",
  "Global Companies",
  "Musicians & Entertainment",
  "Luxury FIT Travel",
  "Executive Leadership",
  "Tour Operators",
  "Major Events"
];

const movement = [
  {
    number: "01",
    title: "Private Chauffeur",
    text: "Sedans, SUVs and executive vehicles for private clients, airport arrivals, meetings, evenings and discreet point-to-point travel."
  },
  {
    number: "02",
    title: "Executive Sprinters",
    text: "Premium private transportation for families, executives, artists and small groups who prefer to travel together."
  },
  {
    number: "03",
    title: "Private Motorcoaches",
    text: "Mini and full-size coaches for executive programs, professional teams, touring artists, private groups and complex itineraries."
  },
  {
    number: "04",
    title: "Private Aviation",
    text: "Private jet charter coordinated with ground transportation, destination services and onward travel."
  },
  {
    number: "05",
    title: "Sports & Entertainment",
    text: "Precision movement for teams, athletes, ownership groups, artists, productions and VIP guests."
  },
  {
    number: "06",
    title: "Complex Group Movements",
    text: "Multi-vehicle, multi-location and time-sensitive programs managed by one team from planning through execution."
  }
];

const experiences = [
  {
    number: "01",
    label: "PRIVATE TRAVEL",
    title: "Bespoke Journeys",
    text: "Highly personalized journeys designed around your interests, schedule, pace and priorities — from one extraordinary day to a complete multi-destination itinerary."
  },
  {
    number: "02",
    label: "CORPORATE",
    title: "Executive Programs",
    text: "Leadership retreats, conferences, client entertainment, executive movements and complex travel programs delivered with discretion and precision."
  },
  {
    number: "03",
    label: "EVENTS",
    title: "High-Touch Events",
    text: "VIP guest movements, launches, premieres, sporting events, productions, executive dinners and brand activations."
  },
  {
    number: "04",
    label: "PRIVATE AVIATION",
    title: "Travel Without Boundaries",
    text: "Private aircraft sourcing coordinated with chauffeur service and destination arrangements for a seamless door-to-door journey."
  }
];

const guyanaServices = [
  "Private Tours",
  "Curated Multi-Day Journeys",
  "Kaieteur Falls",
  "Nature & Wildlife",
  "Cultural Experiences",
  "Private Guides",
  "Airport Transfers",
  "Private Transportation",
  "Hotel Packages",
  "Corporate Travel",
  "Custom Itineraries"
];
---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>

<title>
Travaza | Private Travel, Curated Experiences & Global Movement
</title>

<meta
  name="description"
  content="Travaza creates private travel, curated destination experiences and seamless global movement for private clients, executives, companies, professional sports and entertainment."
/>

<link rel="preconnect" href="https://fonts.googleapis.com" />

<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
/>

<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Manrope:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<style>

:root {
  --black: #050505;
  --white: #ffffff;
  --soft: #f8f8f6;
  --gold: #c89a3d;
  --gold-light: #e6c57d;
  --gold-dark: #98732d;
  --text: #171817;
  --muted: #666a66;
  --line: #e4e5e2;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--white);
  color: var(--text);
  font-family: "Manrope", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
blockquote {
  font-family: "Cormorant Garamond", Georgia, serif;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

input,
select,
textarea,
button {
  font: inherit;
}

.container {
  width: min(1240px, calc(100% - 48px));
  margin: auto;
}

.eyebrow {
  color: var(--gold-dark);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.eyebrow-light {
  color: var(--gold-light);
}

.section-title {
  margin: 15px 0 22px;
  font-size: clamp(52px, 6.5vw, 90px);
  line-height: .93;
  font-weight: 400;
  letter-spacing: -.035em;
}

.section-copy {
  max-width: 700px;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.8;
}

.button {
  min-height: 55px;
  padding: 0 27px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .17em;
  text-transform: uppercase;
  cursor: pointer;
}

.button-gold {
  background: var(--gold);
  color: #080808;
}

.button-dark {
  background: var(--black);
  color: white;
}

.button-outline {
  border: 1px solid rgba(255,255,255,.5);
  color: white;
  background: transparent;
}


/* HEADER */

header {
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 50;
  border-bottom: 1px solid rgba(255,255,255,.2);
}

.nav {
  min-height: 92px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.logo {
  width: 188px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-links a {
  color: rgba(255,255,255,.88);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.nav-cta {
  padding: 13px 17px;
  border: 1px solid rgba(230,197,125,.8);
}


/* HERO */

.hero {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  color: white;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.78) 0%,
      rgba(0,0,0,.40) 48%,
      rgba(0,0,0,.12) 100%
    ),
    linear-gradient(
      0deg,
      rgba(0,0,0,.58) 0%,
      transparent 55%
    );
}

.hero-content {
  position: relative;
  z-index: 2;
  padding-bottom: 85px;
  max-width: 950px;
}

.hero h1 {
  margin: 25px 0 28px;
  font-size: clamp(80px, 10vw, 145px);
  line-height: .78;
  font-weight: 300;
  letter-spacing: -.055em;
}

.hero h1 span {
  color: var(--gold-light);
  font-style: italic;
}

.hero-copy {
  max-width: 730px;
  margin: 0;
  color: rgba(255,255,255,.88);
  font-size: 19px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 35px;
}


/* CURATED DESTINATIONS */

.destination-intro {
  padding: 125px 0 70px;
  background: var(--black);
  color: white;
}

.destination-intro .section-copy {
  color: rgba(255,255,255,.62);
}


/* NEW YORK */

.destination-feature {
  min-height: 720px;
  position: relative;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  color: white;
}

.destination-feature img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.destination-feature:after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.86),
      rgba(0,0,0,.05) 70%
    );
}

.destination-content {
  position: relative;
  z-index: 2;
  max-width: 720px;
  padding-bottom: 65px;
}

.destination-content h2 {
  margin: 10px 0 12px;
  font-size: clamp(58px, 7vw, 94px);
  line-height: .9;
  font-weight: 400;
}

.destination-content p {
  max-width: 620px;
  color: rgba(255,255,255,.78);
  line-height: 1.75;
}


/* LONDON PARIS */

.city-pair {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  background: black;
}

.city-card {
  min-height: 650px;
  position: relative;
  overflow: hidden;
}

.city-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.city-card:after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.82),
      rgba(0,0,0,.04) 70%
    );
}

.city-content {
  position: absolute;
  z-index: 2;
  left: 42px;
  right: 42px;
  bottom: 44px;
  color: white;
}

.city-content h3 {
  margin: 8px 0;
  font-size: 59px;
  font-weight: 400;
  line-height: .95;
}

.city-content p {
  max-width: 480px;
  margin: 0;
  color: rgba(255,255,255,.74);
  font-size: 13px;
  line-height: 1.65;
}


/* NIAGARA */

.niagara {
  padding: 125px 0;
  background: var(--black);
  color: white;
}

.niagara-heading {
  max-width: 790px;
  margin-bottom: 55px;
}

.niagara-heading .section-copy {
  color: rgba(255,255,255,.62);
}

.niagara-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.niagara-card {
  min-height: 620px;
  position: relative;
  overflow: hidden;
}

.niagara-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.niagara-card:after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.88),
      rgba(0,0,0,.05) 68%
    );
}

.niagara-content {
  position: absolute;
  z-index: 2;
  bottom: 38px;
  left: 35px;
  right: 35px;
}

.niagara-content h3 {
  margin: 8px 0;
  font-size: 47px;
  line-height: .95;
  font-weight: 400;
}

.niagara-content p {
  max-width: 520px;
  margin: 0;
  color: rgba(255,255,255,.72);
  font-size: 13px;
  line-height: 1.7;
}


/* GUYANA */

.guyana {
  min-height: 830px;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: white;
}

.guyana img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.guyana:after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.90),
      rgba(0,0,0,.37) 63%,
      rgba(0,0,0,.12)
    );
}

.guyana-content {
  position: relative;
  z-index: 2;
  max-width: 730px;
  padding: 85px 0;
}

.year {
  display: inline-block;
  padding: 10px 14px;
  border: 1px solid rgba(230,197,125,.7);
  color: var(--gold-light);
  font-size: 9px;
  letter-spacing: .17em;
}

.guyana h2 {
  margin: 21px 0;
  font-size: clamp(62px, 7.5vw, 103px);
  line-height: .88;
  font-weight: 400;
}

.guyana-lead {
  max-width: 660px;
  color: rgba(255,255,255,.84);
  font-size: 18px;
  line-height: 1.8;
}

.guyana-services {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 28px;
}

.guyana-service {
  padding: 9px 11px;
  border: 1px solid rgba(255,255,255,.28);
  color: rgba(255,255,255,.8);
  font-size: 10px;
}


/* TRAVEL BUILT AROUND YOU */

.travel-built {
  min-height: 730px;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: white;
}

.travel-built img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.travel-built:after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.86),
      rgba(0,0,0,.15)
    );
}

.travel-built-content {
  position: relative;
  z-index: 2;
  max-width: 730px;
}

.travel-built h2 {
  margin: 14px 0 20px;
  font-size: clamp(57px, 7vw, 95px);
  line-height: .9;
  font-weight: 400;
}

.travel-built p {
  max-width: 630px;
  color: rgba(255,255,255,.8);
  font-size: 17px;
  line-height: 1.8;
}


/* GLOBAL MOVEMENT */

.global-movement {
  padding: 130px 0;
  background: white;
}

.movement-intro {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 100px;
  align-items: end;
  margin-bottom: 75px;
}

.movement-lead {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.85;
}

.movement-list {
  border-top: 1px solid var(--line);
}

.movement-row {
  display: grid;
  grid-template-columns: 80px 310px 1fr;
  gap: 35px;
  align-items: center;
  padding: 33px 0;
  border-bottom: 1px solid var(--line);
}

.movement-number {
  color: var(--gold-dark);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .17em;
}

.movement-row h3 {
  margin: 0;
  font-size: 35px;
  font-weight: 400;
}

.movement-row p {
  max-width: 640px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.movement-footer {
  margin-top: 75px;
  padding: 58px 65px;
  background: var(--black);
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 45px;
}

.movement-footer h3 {
  max-width: 760px;
  margin: 0;
  font-size: clamp(40px, 5vw, 65px);
  line-height: .96;
  font-weight: 400;
}


/* TRAVAZA APPROACH */

.approach {
  padding: 140px 0;
  background: var(--soft);
}

.approach-grid {
  display: grid;
  grid-template-columns: .82fr 1.18fr;
  gap: 105px;
}

.approach-copy {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.9;
}

.approach-copy strong {
  color: var(--text);
  font-weight: 500;
}

.approach-statement {
  margin-top: 35px;
  padding-top: 30px;
  border-top: 1px solid var(--line);
  color: var(--text);
  font-family: "Cormorant Garamond", serif;
  font-size: 36px;
  line-height: 1.2;
}

.audience {
  margin-top: 80px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
  display: flex;
  flex-wrap: wrap;
  gap: 17px 35px;
}

.audience span {
  color: #626662;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .13em;
  text-transform: uppercase;
}


/* PRIVATE CUSTOM */

.experiences {
  padding: 130px 0;
  background: white;
}

.experience-heading {
  max-width: 830px;
}

.experience-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 60px;
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.experience {
  min-height: 390px;
  padding: 42px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  display: flex;
  flex-direction: column;
}

.experience-number {
  color: var(--gold-dark);
  font-size: 9px;
  letter-spacing: .17em;
}

.experience h3 {
  margin: auto 0 14px;
  font-size: 48px;
  line-height: .98;
  font-weight: 400;
}

.experience p {
  max-width: 500px;
  margin: 0;
  color: var(--muted);
  line-height: 1.75;
}


/* STATEMENT */

.statement {
  padding: 145px 0;
  background: var(--black);
  color: white;
  text-align: center;
}

.statement blockquote {
  max-width: 1000px;
  margin: 22px auto 0;
  font-size: clamp(50px, 6.4vw, 87px);
  line-height: 1;
  font-weight: 400;
}

.statement span {
  color: var(--gold-light);
  font-style: italic;
}


/* CONSULTATION */

.consultation {
  padding: 130px 0;
  background: white;
}

.consultation-grid {
  display: grid;
  grid-template-columns: .72fr 1.28fr;
  gap: 95px;
}

.consultation-text {
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
}

.contact {
  margin-top: 30px;
  padding-top: 25px;
  border-top: 1px solid var(--line);
}

.contact a {
  font-weight: 600;
}

.form {
  padding: 40px;
  border: 1px solid var(--line);
}

.form h3 {
  margin: 0 0 28px;
  font-size: 42px;
  font-weight: 400;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 17px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.full {
  grid-column: 1 / -1;
}

label {
  color: #626762;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
}

input,
select,
textarea {
  width: 100%;
  min-height: 51px;
  padding: 12px 13px;
  border: 1px solid #d9dcd9;
  background: #fafafa;
  border-radius: 0;
  outline: none;
}

textarea {
  min-height: 145px;
  resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--gold);
}

.submit {
  width: 100%;
  min-height: 59px;
  margin-top: 19px;
  border: none;
  background: var(--black);
  color: white;
  cursor: pointer;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
}


/* FOOTER */

footer {
  padding: 68px 0 35px;
  background: var(--black);
  color: white;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr .7fr .7fr;
  gap: 60px;
}

.footer-logo {
  width: 205px;
}

.footer-copy {
  max-width: 450px;
  margin-top: 20px;
  color: rgba(255,255,255,.48);
  font-size: 12px;
  line-height: 1.7;
}

.footer-title {
  margin-bottom: 17px;
  color: var(--gold-light);
  font-size: 9px;
  letter-spacing: .18em;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 11px;
  color: rgba(255,255,255,.65);
  font-size: 12px;
}

.legal {
  margin-top: 52px;
  padding-top: 23px;
  border-top: 1px solid rgba(255,255,255,.13);
  color: rgba(255,255,255,.35);
  font-size: 9px;
  line-height: 1.6;
}


/* RESPONSIVE */

@media (max-width: 900px) {

  .nav-links a:not(.nav-cta) {
    display: none;
  }

  .city-pair,
  .niagara-grid,
  .movement-intro,
  .approach-grid,
  .consultation-grid {
    grid-template-columns: 1fr;
  }

  .movement-row {
    grid-template-columns: 55px 1fr;
  }

  .movement-row p {
    grid-column: 2;
  }

  .movement-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-grid > div:first-child {
    grid-column: 1 / -1;
  }

}

@media (max-width: 640px) {

  .container {
    width: calc(100% - 28px);
  }

  .nav {
    min-height: 76px;
  }

  .logo {
    width: 150px;
  }

  .hero {
    min-height: 820px;
  }

  .hero-content {
    padding-bottom: 60px;
  }

  .destination-intro,
  .niagara,
  .global-movement,
  .approach,
  .experiences,
  .statement,
  .consultation {
    padding: 82px 0;
  }

  .city-card {
    min-height: 550px;
  }

  .niagara-card {
    min-height: 520px;
  }

  .guyana {
    min-height: 780px;
  }

  .travel-built {
    min-height: 650px;
  }

  .movement-row {
    grid-template-columns: 40px 1fr;
    gap: 18px;
  }

  .movement-footer {
    padding: 38px 27px;
  }

  .experience-grid {
    grid-template-columns: 1fr;
  }

  .experience {
    min-height: 350px;
    padding: 28px;
  }

  .form {
    padding: 27px 18px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .full {
    grid-column: auto;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid > div:first-child {
    grid-column: auto;
  }

}

</style>

</head>


<body>


<!-- HEADER -->

<header>

<div class="container nav">

<a href="/">

<img
  class="logo"
  src="/images/travaza/travaza-gold.png"
  alt="Travaza"
/>

</a>


<nav class="nav-links">

<a href="#destinations">
Destinations
</a>

<a href="#global-movement">
Global Movement
</a>

