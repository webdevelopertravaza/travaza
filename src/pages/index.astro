.quote-form h3 {

  margin:
    0
    0
    27px;

  font-size: 28px;

  font-weight: 300;

}


.form-grid {

  display: grid;

  grid-template-columns:
    repeat(
      2,
      1fr
    );

  gap: 18px;

}


.field {

  display: flex;

  flex-direction: column;

  gap: 8px;

}


.field-full {

  grid-column:
    1 / -1;

}


label {

  color: #626662;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .12em;

  text-transform: uppercase;

}


input,
select,
textarea {

  width: 100%;

  min-height: 51px;

  padding:
    12px
    13px;

  border:
    1px solid
    #d9dbd8;

  background: #faf9f6;

  outline: none;

  color: var(--dark-text);

  border-radius: 0;

}


textarea {

  min-height: 140px;

  resize: vertical;

}


input:focus,
select:focus,
textarea:focus {

  border-color: var(--gold);

}


.submit {

  width: 100%;

  min-height: 59px;

  margin-top: 20px;

  border: none;

  background: var(--black);

  color: white;

  cursor: pointer;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .14em;

  text-transform: uppercase;

}


.submit:hover {

  color: var(--gold-light);

}


.form-note {

  margin-top: 14px;

  color: #777b77;

  font-size: 11px;

  line-height: 1.5;

}



/* =========================================
FOOTER
========================================= */


footer {

  padding:
    68px
    0
    35px;

  background: #020302;

  border-top:
    1px solid
    var(--light-line);

}


.footer-grid {

  display: grid;

  grid-template-columns:
    1.35fr
    .7fr
    .7fr;

  gap: 60px;

}


.footer-logo {

  width: 210px;

  margin-bottom: 20px;

}


.footer-copy {

  max-width: 450px;

  color:
    rgba(
      255,
      255,
      255,
      .47
    );

  line-height: 1.65;

  font-size: 13px;

}


.footer-heading {

  color: var(--gold);

  letter-spacing: .15em;

  font-size: 10px;

  margin-bottom: 18px;

}


.footer-links {

  display: flex;

  flex-direction: column;

  gap: 11px;

  color:
    rgba(
      255,
      255,
      255,
      .61
    );

  font-size: 13px;

}


.legal {

  margin-top: 55px;

  padding-top: 24px;

  border-top:
    1px solid
    var(--light-line);

  color:
    rgba(
      255,
      255,
      255,
      .35
    );

  font-size: 10px;

  line-height: 1.6;

}



/* =========================================
MOBILE
========================================= */


@media
(max-width: 900px) {


  .nav-links a:not(.nav-button) {

    display: none;

  }


  .who-grid,
  .guyana-grid,
  .movement-grid,
  .contact-grid {

    grid-template-columns: 1fr;

    gap: 50px;

  }


  .clients-grid {

    grid-template-columns:
      repeat(
        2,
        1fr
      );

  }


  .division-grid {

    grid-template-columns: 1fr;

  }


  .destination-row {

    grid-template-columns:
      150px
      1fr;

  }


  .destination-row > div:last-child {

    grid-column: 2;

  }


  .signature-grid {

    grid-template-columns:
      repeat(
        2,
        1fr
      );

  }


  .footer-grid {

    grid-template-columns:
      1fr
      1fr;

  }


  .footer-grid > div:first-child {

    grid-column:
      1 / -1;

  }

}



@media
(max-width: 640px) {


  .container {

    width:
      calc(
        100% - 28px
      );

  }


  .nav {

    min-height: 76px;

  }


  .logo {

    width: 150px;

  }


  .hero {

    min-height: 820px;

  }


  .hero-inner {

    padding-top: 110px;

  }


  .hero-bottom {

    grid-template-columns:
      repeat(
        2,
        1fr
      );

  }


  .clients-grid {

    grid-template-columns: 1fr;

  }


  .division {

    min-height: 450px;

    padding: 28px;

  }


  .destination-row {

    grid-template-columns: 1fr;

    gap: 17px;

    padding:
      37px
      0;

  }


  .destination-row > div:last-child {

    grid-column: auto;

  }


  .signature-grid {

    grid-template-columns: 1fr;

  }


  .guyana-services,
  .movement-services {

    grid-template-columns: 1fr;

  }


  .quote-form {

    padding:
      27px
      18px;

  }


  .form-grid {

    grid-template-columns: 1fr;

  }


  .field-full {

    grid-column: auto;

  }


  .footer-grid {

    grid-template-columns: 1fr;

  }


  .footer-grid > div:first-child {

    grid-column: auto;

  }


  .who,
  .clients,
  .what,
  .where,
  .guyana-feature,
  .signature,
  .movement,
  .statement,
  .contact {

    padding:
      82px
      0;

  }

}


</style>


