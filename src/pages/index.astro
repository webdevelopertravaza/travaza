      color: var(--muted);
    }

    .small { font-size: 13px; }
    .muted { color: var(--muted); }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 48px;
      padding: 12px 22px;
      background: var(--red);
      border: 1px solid transparent;
      border-radius: 9px;
      color: #fff;
      font-weight: 750;
      text-decoration: none;
      cursor: pointer;
    }

    .btn:hover { background: var(--red-hover); }
    .btn.blue { background: var(--blue); }
