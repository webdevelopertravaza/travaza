    }

    .destination-card .photo img { height: 185px; }
    .destination-card h3 { font-size: 25px; }
    .destination-card .card-body { padding: 22px; }
    .destination-card p { font-size: 14px; }
    .destination-card .text-link { font-size: 13px; }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }

    .why-grid > div {
      border-top: 3px solid var(--red);
      padding-top: 20px;
    }

    .why-grid h3 { font-size: 22px; }
    .why-grid p { color: var(--muted); }

    .faq details {
      border-bottom: 1px solid var(--line);
      padding: 20px 0;
    }

    .faq summary {
      font-weight: 750;
      cursor: pointer;
    }

    .faq details p {
      margin: 14px 0 0;
      color: var(--muted);
    }

    .contact {
      background: var(--blue);
      color: white;
    }

    .contact .eyebrow { color: #c2d9fb; }
    .contact p { color: #e0eafa; }

    .contact a {
      color: #fff;
      overflow-wrap: anywhere;
    }

    .contact-form {
      padding: 28px;
      border-radius: var(--radius);
      background: white;
      color: var(--ink);
    }

    .contact-form label {
      display: block;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 6px;
    }

    .field { margin-bottom: 17px; }

    .contact-form input,
    .contact-form select,
    .contact-form textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #bfcde0;
      border-radius: 8px;
      color: var(--ink);
      background: white;
    }

    .contact-form textarea {
      min-height: 110px;
      resize: vertical;
    }

    .contact-form .btn { width: 100%; }
    .contact-form p { color: var(--muted); }

    .footer {
      background: var(--navy);
      color: white;
      padding: 45px 0 22px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 30px;
    }

    .footer .logo { color: white; }

    .footer h3 {
      font-size: 16px;
      letter-spacing: 0;
    }

    .footer p {
      color: #c5d5ec;
      font-size: 14px;
    }

    .footer a {
      display: block;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 9px;
    }

    .footer .logo { font-size: 30px; }

    .footer-bottom {
      border-top: 1px solid #345073;
      margin-top: 25px;
      padding-top: 20px;
      color: #c5d5ec;
      font-size: 12px;
    }

    .credits {
      margin-top: 18px;
      font-size: 11px;
      color: #c5d5ec;
    }

    .credits summary { cursor: pointer; }
    .credits ul { padding-left: 18px; }

    .credits a {
      display: inline;
      text-decoration: underline;
      font-size: 11px;
    }

    .credits li { margin: 6px 0; }

    @media (max-width: 950px) {
      .three { grid-template-columns: 1fr 1fr; }

      .three > .tour-card:last-child {
        grid-column: 1 / -1;
      }

      .destinations { grid-template-columns: 1fr 1fr; }
      .nav-links { gap: 13px; }
      .nav-links a { font-size: 12px; }
      .hero { min-height: 510px; }

      .hero:after {
        background: linear-gradient(90deg, #051c3eee, #051c3e88);
      }
    }

    @media (max-width: 680px) {
      .wrap { padding: 0 20px; }
      .section { padding: 48px 0; }

      .nav {
        min-height: 70px;
        flex-wrap: wrap;
      }

      .menu-toggle { display: block; }

      .nav-links {
        width: 100%;
        flex-wrap: wrap;
        padding-bottom: 16px;
      }

      .header.enhanced .nav-links { display: none; }

      .header.enhanced .nav-links.is-open {
        display: flex;
      }

      .nav-links a { font-size: 14px; }
      .hero { min-height: 520px; }

      .hero-content {
        padding-top: 65px;
        padding-bottom: 65px;
      }

      .hero p:not(.eyebrow) { font-size: 17px; }

      .three, .two, .destinations, .why-grid {
        grid-template-columns: 1fr;
      }

      .three > .tour-card:last-child {
        grid-column: auto;
      }

      .photo img { height: 220px; }
      .destination-card .photo img { height: 210px; }
      .booking-box { padding: 22px 14px; }

      .banner {
        align-items: flex-start;
        flex-direction: column;
        padding: 24px;
      }

      .finder strong { width: 100%; }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-grid > div:first-child {
        grid-column: 1 / -1;
      }

      .contact-form { padding: 22px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .photo img { transition: none; }

      .tour-card:hover .photo img,
      .destination-card:hover .photo img {
        transform: none;
      }
    }
  </style>
</head>

