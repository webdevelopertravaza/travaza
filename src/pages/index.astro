---
const collections = [
  {
    title: "Golf Escapes",
    kicker: "PLAY SOMEWHERE EXTRAORDINARY",
    description:
      "Championship courses, luxury stays and thoughtfully planned golf getaways in remarkable destinations around the world.",
    image:
      "https://images.unsplash.com/photo-1587174486073-ae5e5cff23aa?auto=format&fit=crop&w=1600&q=85",
  },
  {
    title: "Spa & Wellness",
    kicker: "RESET",
    description:
      "Luxury spa retreats, wellness weekends and restorative escapes designed around you.",
    image:
      "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1600&q=85",
  },
  {
    title: "Weekend Getaways",
    kicker: "ESCAPE",
    description:
      "A few days can change everything. Curated city stays, countryside retreats and spontaneous luxury escapes.",
    image:
      "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=85",
  },
  {
    title: "Private Aviation",
    kicker: "FLY YOUR WAY",
    description:
      "Private aviation and bespoke air travel coordinated around your schedule, destination and experience.",
    image:
      "https://images.unsplash.com/photo-1540962351504-03099e0a754b?auto=format&fit=crop&w=1600&q=85",
  },
  {
    title: "Corporate Retreats",
    kicker: "GO FURTHER TOGETHER",
    description:
      "Destination retreats, leadership experiences and team escapes created to bring people together.",
    image:
      "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1600&q=85",
  },
  {
    title: "Private Transportation",
    kicker: "MOVE EFFORTLESSLY",
    description:
      "Premium transportation, private drivers, executive vehicles, coaches, airport transfers and group movements.",
    image:
      "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1600&q=85",
  },
];

const trending = [
  {
    title: "Aurora Borealis",
    location: "Canada & Iceland",
    eyebrow: "CHASE THE NORTHERN LIGHTS",
    description:
      "Remote landscapes. Dark skies. Extraordinary nights. Let us design a Northern Lights escape worth travelling for.",
    image:
      "https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=1800&q=90",
  },
  {
    title: "Fall Colours",
    location: "Canada",
    eyebrow: "AUTUMN, ELEVATED",
    description:
      "Experience Canada's spectacular fall landscapes through private touring, countryside stays and curated seasonal escapes.",
    image:
      "https://images.unsplash.com/photo-1508193638397-1c4234db14d8?auto=format&fit=crop&w=1800&q=90",
  },
  {
    title: "Québec City",
    location: "Québec, Canada",
    eyebrow: "OLD WORLD. CLOSE TO HOME.",
    description:
      "Historic streets, exceptional dining, beautiful hotels and unmistakable European character.",
    image:
      "https://images.unsplash.com/photo-1519178614-68673b201f36?auto=format&fit=crop&w=1800&q=90",
  },
];

const destinations = [
  { name: "Canada", label: "Wilderness • Cities • Four Seasons" },
  { name: "USA", label: "Iconic Cities • Coastlines • Resorts" },
  { name: "Thailand", label: "Islands • Wellness • Culture" },
  { name: "Switzerland", label: "Alps • Rail • Luxury" },
  { name: "Italy", label: "Food • Art • Coastlines" },
  { name: "Greece", label: "Islands • Yachts • Mediterranean" },
  { name: "London", label: "Culture • Dining • Private Access" },
  { name: "Paris", label: "Fashion • Cuisine • Romance" },
  { name: "Japan", label: "Tradition • Design • Discovery" },
  { name: "Iceland", label: "Adventure • Nature • Northern Lights" },
  { name: "South Africa", label: "Safari • Wine • Coast" },
  { name: "Guyana", label: "Rainforest • Wildlife • Adventure" },
];

const corporateServices = [
  "Corporate Events",
  "Conference Services",
  "Corporate Retreats",
  "Team Building Experiences",
  "Transportation & Shuttles",
  "Step-On Guides",
  "Airport Meet & Greets",
  "VIP Transportation",
  "Private Touring",
  "Group Logistics",
];

const yachtImages = [
  "https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?auto=format&fit=crop&w=1800&q=90",
  "https://images.unsplash.com/photo-1540946485063-a40da27545f8?auto=format&fit=crop&w=1800&q=90",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Travaza creates extraordinary travel experiences around the world, from private aviation and luxury escapes to yachts, corporate retreats, conferences and premium transportation."
    />

    <title>Travaza | The World, Handled.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <!-- ======================================================
         HERO — KEEP THIS VISUAL / PHOTO-HEAVY
    ======================================================= -->

    <header class="hero">

      <nav class="nav">
        <a href="/" class="brand">TRAVAZA</a>

        <div class="nav-links">
          <a href="#experiences">Experiences</a>
          <a href="#destinations">Destinations</a>
          <a href="#yachts">Yachts</a>
          <a href="#corporate">Corporate</a>
        </div>

        <a href="#plan" class="nav-button">Plan Your Journey</a>
      </nav>

      <div class="hero-grid">

        <div
          class="hero-image hero-one"
          style="background-image:url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1800&q=90')"
        ></div>

        <div
          class="hero-image hero-two"
          style="background-image:url('https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=1600&q=90')"
        ></div>

        <div
          class="hero-image hero-three"
          style="background-image:url('https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=1600&q=90')"
        ></div>

        <div class="hero-overlay"></div>

        <div class="hero-content">
          <p class="eyebrow light">TRAVEL WITHOUT LIMITS</p>

          <h1>
            The world,<br />
            <em>handled.</em>
          </h1>

          <p class="hero-copy">
            Extraordinary experiences, private journeys and seamless
            travel around the world.
          </p>

          <a href="#experiences" class="button light-button">
            Explore Travaza
          </a>
        </div>

      </div>
    </header>


    <!-- ======================================================
         INTRO
    ======================================================= -->

    <section class="intro">

      <p class="eyebrow">TRAVAZA GLOBAL</p>

      <h2>
        Wherever you want to go,<br />
        <em>we make it happen.</em>
      </h2>

      <p class="intro-copy">
        Travaza is a global travel and experiences brand creating
        unforgettable journeys for individuals, families, groups and
        organizations. From a weekend escape to a multi-country itinerary,
        private aviation to a corporate retreat, we bring every element
        together into one seamless experience.
      </p>

      <p class="signature">
        Travel should feel effortless.
      </p>

    </section>


    <!-- ======================================================
         EXPERIENCE COLLECTIONS
    ======================================================= -->

    <section id="experiences" class="collections">

      <div class="section-heading">

        <div>
          <p class="eyebrow">THE TRAVAZA COLLECTION</p>

          <h2>
            Travel designed<br />
            <em>around you.</em>
          </h2>
        </div>

        <p>
          Start with an idea. We’ll build the experience around it.
        </p>

      </div>

      <div class="collection-grid">
        {
          collections.map((item) => (
            <article class="collection-card">

              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
              />

              <div class="card-shade"></div>

              <div class="collection-content">
                <p>{item.kicker}</p>
                <h3>{item.title}</h3>
                <span>{item.description}</span>
              </div>

            </article>
          ))
        }
      </div>

    </section>


    <!-- ======================================================
         TRENDING NOW
    ======================================================= -->

    <section class="trending">

      <div class="center-heading">
        <p class="eyebrow">TRENDING NOW</p>

        <h2>
          Where the world is<br />
          <em>calling.</em>
        </h2>
      </div>

      <div class="trending-grid">

        {
          trending.map((item) => (
            <article class="trend-card">

              <div class="trend-photo">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                />
              </div>

              <div class="trend-copy">

                <p class="eyebrow">{item.eyebrow}</p>

                <h3>{item.title}</h3>

                <span class="location">
                  {item.location}
                </span>

                <p>{item.description}</p>

                <a href="#plan">
                  Create This Experience →
                </a>

              </div>

            </article>
          ))
        }

      </div>

    </section>


    <!-- ======================================================
         GLOBAL DESTINATIONS
    ======================================================= -->

    <section id="destinations" class="destinations">

      <div class="destination-intro">

        <p class="eyebrow light">
          THE WORLD BY TRAVAZA
        </p>

        <h2>
          One world.<br />
          <em>Endless possibilities.</em>
        </h2>

        <p>
          Tell us where you want to go—or let us inspire you.
          Travaza creates custom experiences throughout the world.
        </p>

      </div>

      <div class="destination-list">

        {
          destinations.map((destination, index) => (
            <a href="#plan" class="destination-row">

              <span class="destination-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <h3>{destination.name}</h3>

              <p>{destination.label}</p>

              <span class="arrow">↗</span>

            </a>
          ))
        }

      </div>

    </section>


    <!-- ======================================================
         YACHT COLLECTION
    ======================================================= -->

    <section id="yachts" class="yachts">

      <div class="yacht-images">

        <img
          class="yacht-main"
          src={yachtImages[0]}
          alt="Luxury yacht experience"
          loading="lazy"
        />

        <img
          class="yacht-secondary"
          src={yachtImages[1]}
          alt="Private yacht charter"
          loading="lazy"
        />

      </div>

      <div class="yacht-copy">

        <p class="eyebrow">
          THE TRAVAZA YACHT COLLECTION
        </p>

        <h2>
          Your world.<br />
          <em>From the water.</em>
        </h2>

        <p>
          Private yacht experiences designed for the way you want
          to travel—from intimate escapes and celebrations to
          corporate entertaining and unforgettable days on the water.
        </p>

        <p>
          Tell us the destination, the occasion and the people you
          want beside you. We’ll help create the rest.
        </p>

        <a href="#plan" class="button dark-button">
          Explore Yacht Experiences
        </a>

      </div>

    </section>


    <!-- ======================================================
         CORPORATE
    ======================================================= -->

    <section id="corporate" class="corporate">

      <div class="corporate-copy">

        <p class="eyebrow light">
          TRAVAZA FOR BUSINESS
        </p>

        <h2>
          Bring people together.<br />
          <em>We’ll handle everything else.</em>
        </h2>

        <p>
          From ten executives to thousands of conference delegates,
          Travaza coordinates the experiences and logistics that
          keep people moving, connected and engaged.
        </p>

        <a href="#plan" class="button light-button">
          Plan a Corporate Experience
        </a>

      </div>

      <div class="corporate-services">

        {
          corporateServices.map((service, index) => (
            <div class="service-row">
              <span>
                {String(index + 1).padStart(2, "0")}
              </span>
              <p>{service}</p>
            </div>
          ))
        }

      </div>

    </section>


    <!-- ======================================================
         TRANSPORTATION
    ======================================================= -->

    <section class="transport">

      <div class="transport-photo">
        <img
          src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1800&q=90"
          alt="Premium group transportation"
          loading="lazy"
        />
      </div>

      <div class="transport-copy">

        <p class="eyebrow">
          TRAVAZA MOBILITY
        </p>

        <h2>
          From arrival<br />
          <em>to everywhere.</em>
        </h2>

        <p>
          Seamless transportation is part of the experience.
          Travaza coordinates private vehicles, executive
          transportation, airport transfers, group shuttles and
          highway coaches for travellers and organizations.
        </p>

        <div class="mini-services">
          <span>Airport Transfers</span>
          <span>Meet & Greet</span>
          <span>Executive Transportation</span>
          <span>Conference Shuttles</span>
          <span>Motorcoach Transportation</span>
          <span>Step-On Guides</span>
        </div>

        <a href="#plan" class="text-link">
          Arrange Transportation →
        </a>

      </div>

    </section>


    <!-- ======================================================
         CUSTOM JOURNEYS
    ======================================================= -->

    <section class="custom">

      <div class="custom-inner">

        <p class="eyebrow light">
          MADE FOR YOU
        </p>

        <h2>
          Don't choose an itinerary.<br />
          <em>Create one.</em>
        </h2>

        <p>
          A private villa in Greece. Golf in Scotland.
          The Northern Lights in Iceland. A family journey through
          Japan. A corporate retreat in Canada. A yacht in the
          Mediterranean.
        </p>

        <p>
          Tell us what extraordinary looks like to you.
        </p>

        <a href="#plan" class="button light-button">
          Create My Experience
        </a>

      </div>

    </section>


    <!-- ======================================================
         INQUIRY / CTA
    ======================================================= -->

    <section id="plan" class="plan">

      <div class="plan-heading">

        <p class="eyebrow">
          START SOMEWHERE
        </p>

        <h2>
          Where do you want<br />
          to go <em>next?</em>
        </h2>

        <p>
          Share your destination, occasion or simply an idea.
          Our team will help turn it into an experience.
        </p>

      </div>

      <form
        name="travaza-experience-request"
        method="POST"
        data-netlify="true"
        class="experience-form"
      >

        <input
          type="hidden"
          name="form-name"
          value="travaza-experience-request"
        />

        <div class="form-row">

          <label>
            Name
            <input
              type="text"
              name="name"
              required
              placeholder="Your name"
            />
          </label>

          <label>
            Email
            <input
              type="email"
              name="email"
              required
              placeholder="you@email.com"
            />
          </label>

        </div>

        <div class="form-row">

          <label>
            I'm interested in
            <select name="experience">
              <option>Custom Travel Experience</option>
              <option>Golf Package</option>
              <option>Spa & Wellness</option>
              <option>Weekend Getaway</option>
              <option>Private Aviation</option>
              <option>Yacht Experience</option>
              <option>Corporate Retreat</option>
              <option>Conference Services</option>
              <option>Transportation</option>
              <option>Airport Meet & Greet</option>
            </select>
          </label>

          <label>
            Destination
            <input
              type="text"
              name="destination"
              placeholder="Where would you like to go?"
            />
          </label>

        </div>

        <label>
          Tell us what you're imagining
          <textarea
            name="message"
            rows="5"
            placeholder="Dates, number of guests, occasion, destinations or anything else you'd like us to know..."
          ></textarea>
        </label>

        <button type="submit">
          Begin My Journey
        </button>

      </form>

    </section>


    <!-- ======================================================
         FOOTER
    ======================================================= -->

    <footer>

      <div class="footer-brand">
        TRAVAZA
      </div>

      <p>
        Global Travel • Experiences • Events • Transportation
      </p>

      <p class="footer-tagline">
        The world, handled.
      </p>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Travaza</span>
        <span>Travel should feel effortless.</span>
      </div>

    </footer>


    <style>

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #f7f5f1;
        color: #171717;
        font-family: "Manrope", sans-serif;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      img {
        width: 100%;
        display: block;
      }


      /* ==========================
         GLOBAL
      ========================== */

      .eyebrow {
        margin: 0 0 18px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .24em;
      }

      .eyebrow.light {
        color: rgba(255,255,255,.72);
      }

      h1,
      h2,
      h3 {
        font-family: "Cormorant Garamond", serif;
        font-weight: 400;
      }

      h2 {
        margin: 0;
        font-size: clamp(48px, 6vw, 82px);
        line-height: .94;
      }

      em {
        font-weight: 400;
      }

      .button {
        display: inline-block;
        padding: 15px 25px;
        font-size: 11px;
        letter-spacing: .13em;
        text-transform: uppercase;
        transition: .25s ease;
      }

      .light-button {
        border: 1px solid rgba(255,255,255,.7);
        color: white;
      }

      .light-button:hover {
        background: white;
        color: #111;
      }

      .dark-button {
        border: 1px solid #111;
      }

      .dark-button:hover {
        background: #111;
        color: white;
      }


      /* ==========================
         HERO
      ========================== */

      .hero {
        background: #111;
        color: white;
      }

      .nav {
        position: absolute;
        z-index: 20;
        top: 0;
        left: 0;
        width: 100%;
        padding: 28px 5vw;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-size: 21px;
        font-weight: 600;
        letter-spacing: .32em;
      }

      .nav-links {
        display: flex;
        gap: 34px;
        font-size: 12px;
      }

      .nav-button {
        padding: 12px 18px;
        border: 1px solid rgba(255,255,255,.55);
        font-size: 10px;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .hero-grid {
        min-height: 94vh;
        position: relative;
        display: grid;
        grid-template-columns: 1.4fr .8fr;
        grid-template-rows: 1fr 1fr;
        gap: 3px;
        overflow: hidden;
      }

      .hero-image {
        background-size: cover;
        background-position: center;
      }

      .hero-one {
        grid-row: 1 / 3;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            90deg,
            rgba(0,0,0,.68),
            rgba(0,0,0,.12) 70%
          );
      }

      .hero-content {
        position: absolute;
        z-index: 5;
        left: 7vw;
        bottom: 11vh;
        max-width: 720px;
      }

      .hero-content h1 {
        margin: 0;
        font-size: clamp(75px, 10vw, 145px);
        line-height: .75;
        letter-spacing: -.04em;
      }

      .hero-copy {
        max-width: 490px;
        margin: 36px 0;
        font-size: 17px;
        line-height: 1.7;
        color: rgba(255,255,255,.86);
      }


      /* ==========================
         INTRO
      ========================== */

      .intro {
        padding: 130px 7vw;
        text-align: center;
      }

      .intro-copy {
        max-width: 750px;
        margin: 42px auto 0;
        font-size: 17px;
        line-height: 1.9;
        color: #5f5b55;
      }

      .signature {
        margin: 38px 0 0;
        font-family: "Cormorant Garamond", serif;
        font-size: 28px;
        font-style: italic;
      }


      /* ==========================
         COLLECTIONS
      ========================== */

      .collections {
        padding: 100px 5vw 130px;
        background: white;
      }

      .section-heading {
        max-width: 1300px;
        margin: 0 auto 65px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 40px;
      }

      .section-heading > p {
        max-width: 330px;
        line-height: 1.8;
        color: #77716a;
      }

      .collection-grid {
        max-width: 1400px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .collection-card {
        position: relative;
        min-height: 560px;
        overflow: hidden;
        color: white;
      }

      .collection-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .8s ease;
      }

      .collection-card:hover img {
        transform: scale(1.04);
      }

      .card-shade {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            0deg,
            rgba(0,0,0,.72),
            rgba(0,0,0,.03) 65%
          );
      }

      .collection-content {
        position: absolute;
        z-index: 2;
        left: 30px;
        right: 30px;
        bottom: 32px;
      }

      .collection-content > p {
        font-size: 9px;
        letter-spacing: .2em;
      }

      .collection-content h3 {
        margin: 7px 0 12px;
        font-size: 42px;
      }

      .collection-content span {
        display: block;
        font-size: 13px;
        line-height: 1.7;
        color: rgba(255,255,255,.78);
      }


      /* ==========================
         TRENDING
      ========================== */

      .trending {
        padding: 130px 5vw;
      }

      .center-heading {
        text-align: center;
        margin-bottom: 75px;
      }

      .trending-grid {
        max-width: 1320px;
        margin: auto;
        display: grid;
        gap: 100px;
      }

      .trend-card {
        display: grid;
        grid-template-columns: 1.35fr .65fr;
        align-items: center;
        gap: 7vw;
      }

      .trend-card:nth-child(even) .trend-photo {
        order: 2;
      }

      .trend-photo {
        height: 610px;
        overflow: hidden;
      }

      .trend-photo img {
        height: 100%;
        object-fit: cover;
      }

      .trend-copy h3 {
        margin: 8px 0;
        font-size: 57px;
      }

      .trend-copy .location {
        display: block;
        margin-bottom: 25px;
        font-size: 12px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #8c8173;
      }

      .trend-copy > p:not(.eyebrow) {
        line-height: 1.8;
        color: #68625b;
      }

      .trend-copy a,
      .text-link {
        display: inline-block;
        margin-top: 20px;
        padding-bottom: 5px;
        border-bottom: 1px solid #111;
        font-size: 11px;
        letter-spacing: .12em;
        text-transform: uppercase;
      }


      /* ==========================
         DESTINATIONS
      ========================== */

      .destinations {
        padding: 120px 7vw;
        background: #171817;
        color: white;
        display: grid;
        grid-template-columns: .8fr 1.2fr;
        gap: 9vw;
      }

      .destination-intro {
        position: sticky;
        top: 80px;
        align-self: start;
      }

      .destination-intro p:last-child {
        max-width: 440px;
        margin-top: 35px;
        line-height: 1.8;
        color: rgba(255,255,255,.6);
      }

      .destination-row {
        padding: 24px 0;
        border-bottom: 1px solid rgba(255,255,255,.15);
        display: grid;
        grid-template-columns: 45px 1fr 1fr 30px;
        gap: 20px;
        align-items: center;
      }

      .destination-number {
        font-size: 10px;
        color: #9b8b72;
      }

      .destination-row h3 {
        margin: 0;
        font-size: 38px;
      }

      .destination-row p {
        margin: 0;
        font-size: 11px;
        color: rgba(255,255,255,.55);
      }


      /* ==========================
         YACHTS
      ========================== */

      .yachts {
        padding: 140px 7vw;
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        align-items: center;
        gap: 8vw;
        background: #efede8;
      }

      .yacht-images {
        position: relative;
        min-height: 720px;
      }

      .yacht-main {
        width: 82%;
        height: 650px;
        object-fit: cover;
      }

      .yacht-secondary {
        position: absolute;
        width: 48%;
        height: 320px;
        right: 0;
        bottom: 0;
        object-fit: cover;
        border: 10px solid #efede8;
      }

      .yacht-copy p:not(.eyebrow) {
        line-height: 1.9;
        color: #68625b;
      }

      .yacht-copy h2 {
        margin-bottom: 35px;
      }

      .yacht-copy .button {
        margin-top: 20px;
      }


      /* ==========================
         CORPORATE
      ========================== */

      .corporate {
        padding: 130px 7vw;
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        gap: 9vw;
        background: #24231f;
        color: white;
      }

      .corporate-copy > p:not(.eyebrow) {
        max-width: 520px;
        margin: 35px 0;
        line-height: 1.9;
        color: rgba(255,255,255,.65);
      }

      .service-row {
        display: grid;
        grid-template-columns: 55px 1fr;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid rgba(255,255,255,.16);
      }

      .service-row span {
        font-size: 10px;
        color: #a99370;
      }

      .service-row p {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-size: 30px;
      }


      /* ==========================
         TRANSPORT
      ========================== */

      .transport {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 700px;
        background: white;
      }

      .transport-photo img {
        height: 100%;
        object-fit: cover;
      }

      .transport-copy {
        padding: 100px 8vw;
        align-self: center;
      }

      .transport-copy > p:not(.eyebrow) {
        margin: 35px 0;
        line-height: 1.9;
        color: #68625b;
      }

      .mini-services {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .mini-services span {
        padding: 9px 12px;
        border: 1px solid #d8d3ca;
        font-size: 10px;
        letter-spacing: .05em;
      }


      /* ==========================
         CUSTOM
      ========================== */

      .custom {
        min-height: 760px;
        padding: 120px 7vw;
        display: flex;
        align-items: center;
        text-align: center;
        color: white;
        background:
          linear-gradient(rgba(0,0,0,.45), rgba(0,0,0,.58)),
          url("https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=2000&q=90")
          center / cover;
      }

      .custom-inner {
        max-width: 900px;
        margin: auto;
      }

      .custom-inner > p:not(.eyebrow) {
        max-width: 700px;
        margin: 30px auto;
        line-height: 1.8;
        color: rgba(255,255,255,.82);
      }


      /* ==========================
         PLAN
      ========================== */

      .plan {
        padding: 130px 7vw;
        display: grid;
        grid-template-columns: .8fr 1.2fr;
        gap: 9vw;
        background: #f7f5f1;
      }

      .plan-heading > p:last-child {
        max-width: 470px;
        line-height: 1.8;
        color: #68625b;
      }

      .experience-form {
        display: grid;
        gap: 25px;
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      label {
        display: grid;
        gap: 9px;
        font-size: 10px;
        letter-spacing: .13em;
        text-transform: uppercase;
      }

      input,
      select,
      textarea {
        width: 100%;
        padding: 15px 2px;
        border: 0;
        border-bottom: 1px solid #aaa49a;
        border-radius: 0;
        outline: none;
        background: transparent;
        font: inherit;
        color: #171717;
      }

      textarea {
        resize: vertical;
      }

      .experience-form button {
        width: fit-content;
        margin-top: 15px;
        padding: 17px 30px;
        border: 1px solid #171717;
        background: #171717;
        color: white;
        cursor: pointer;
        font-size: 10px;
        letter-spacing: .16em;
        text-transform: uppercase;
      }


      /* ==========================
         FOOTER
      ========================== */

      footer {
        padding: 90px 7vw 35px;
        text-align: center;
        background: #101110;
        color: white;
      }

      .footer-brand {
        font-size: clamp(42px, 7vw, 100px);
        letter-spacing: .25em;
        font-weight: 500;
      }

      footer > p {
        color: rgba(255,255,255,.55);
      }

      .footer-tagline {
        font-family: "Cormorant Garamond", serif;
        font-size: 25px;
        font-style: italic;
      }

      .footer-bottom {
        margin-top: 70px;
        padding-top: 25px;
        border-top: 1px solid rgba(255,255,255,.12);
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: rgba(255,255,255,.4);
      }


      /* ==========================
         MOBILE
      ========================== */

      @media (max-width: 900px) {

        .nav-links {
          display: none;
        }

        .nav-button {
          padding: 10px;
          font-size: 8px;
        }

        .hero-grid {
          min-height: 90vh;
          display: block;
        }

        .hero-one {
          position: absolute;
          inset: 0;
        }

        .hero-two,
        .hero-three {
          display: none;
        }

        .hero-content {
          left: 7vw;
          right: 7vw;
          bottom: 9vh;
        }

        .hero-content h1 {
          font-size: 76px;
        }

        .intro {
          padding: 95px 7vw;
        }

        .section-heading,
        .trend-card,
        .destinations,
        .yachts,
        .corporate,
        .transport,
        .plan {
          grid-template-columns: 1fr;
        }

        .collection-grid {
          grid-template-columns: 1fr;
        }

        .collection-card {
          min-height: 500px;
        }

        .trend-card {
          gap: 35px;
        }

        .trend-card:nth-child(even) .trend-photo {
          order: initial;
        }

        .trend-photo {
          height: 480px;
        }

        .destinations {
          gap: 60px;
        }

        .destination-intro {
          position: static;
        }

        .destination-row {
          grid-template-columns: 35px 1fr 20px;
        }

        .destination-row p {
          display: none;
        }

        .yacht-images {
          min-height: 520px;
        }

        .yacht-main {
          height: 480px;
        }

        .yacht-secondary {
          height: 220px;
        }

        .transport-photo {
          height: 500px;
        }

        .transport-copy {
          padding: 80px 7vw;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .footer-bottom {
          gap: 15px;
          flex-direction: column;
        }
      }

      @media (max-width: 520px) {

        .nav {
          padding: 22px 20px;
        }

        .brand {
          font-size: 17px;
        }

        .hero-content h1 {
          font-size: 62px;
        }

        h2 {
          font-size: 47px;
        }

        .collections,
        .trending,
        .destinations,
        .yachts,
        .corporate,
        .plan {
          padding-left: 22px;
          padding-right: 22px;
        }

        .collection-card {
          min-height: 450px;
        }

        .trend-photo {
          height: 390px;
        }

        .trend-copy h3 {
          font-size: 44px;
        }

        .destination-row h3 {
          font-size: 31px;
        }

        .yacht-images {
          min-height: 440px;
        }

        .yacht-main {
          width: 92%;
          height: 410px;
        }

        .yacht-secondary {
          width: 52%;
          height: 180px;
        }

        .custom {
          min-height: 650px;
          padding-left: 22px;
          padding-right: 22px;
        }

      }

    </style>

  </body>
</html>
