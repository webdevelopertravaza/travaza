    .btn.outline {
      background: transparent;
      border-color: #9cb3d2;
      color: #fff;
    }

    .btn.outline:hover { background: #ffffff18; }

    .actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .text-link {
      color: var(--blue);
      font-weight: 750;
      text-underline-offset: 4px;
    }

    .skip {
      position: absolute;
      left: -9999px;
    }

    .skip:focus {
      left: 16px;
      top: 16px;
      z-index: 100;
      background: white;
      padding: 10px;
    }

    .topbar {
      background: var(--blue);
      color: #fff;
      text-align: center;
      padding: 8px 15px;
      font-size: 12px;
      letter-spacing: .05em;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: #fffffff5;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      min-height: 78px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 31px;
      letter-spacing: -.06em;
      font-weight: 850;
      color: var(--blue);
      text-decoration: none;
    }

    .logo span { color: var(--red); }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
    }

    .nav-links a {
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .menu-toggle {
      display: none;
      background: white;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 13px;
      color: var(--blue);
    }

    .hero {
      position: relative;
      background: var(--navy);
      color: white;
      min-height: 570px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero > img {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
      inset: 0;
    }

    .hero:after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(5, 28, 62, .96),
        rgba(5, 28, 62, .7) 55%,
        rgba(5, 28, 62, .18)
      );
    }

    .hero-content {
      position: relative;
      z-index: 1;
      padding-top: 85px;
      padding-bottom: 85px;
      width: 100%;
    }

    .hero .eyebrow { color: #c6ddff; }

    .hero p:not(.eyebrow) {
      max-width: 670px;
      font-size: 19px;
      color: #e7eef9;
    }

    .hero .actions { margin-top: 28px; }

    .finder {
      background: var(--navy);
      color: white;
    }

    .finder .wrap {
      display: flex;
      gap: 14px;
      align-items: center;
      flex-wrap: wrap;
      padding-top: 20px;
      padding-bottom: 20px;
    }

    .finder strong { margin-right: auto; }

    .finder a {
      border: 1px solid #47648c;
      border-radius: 50px;
      padding: 8px 16px;
      text-decoration: none;
      font-size: 13px;
    }

    .finder a:hover { background: var(--blue); }

    .grid {
      display: grid;
      gap: 24px;
    }

    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tour-card,
    .destination-card {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: white;
      overflow: hidden;
      box-shadow: 0 8px 25px #08264d08;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .photo {
      position: relative;
      background: #dbe7f6;
      overflow: hidden;
    }

    .photo img {
      display: block;
      width: 100%;
      height: 240px;
      object-fit: cover;
      transition: transform .3s;
    }

    .tour-card:hover .photo img,
    .destination-card:hover .photo img {
      transform: scale(1.035);
    }

    .badge {
      position: absolute;
      left: 18px;
      top: 18px;
      background: white;
      color: var(--blue);
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .04em;
    }

    .badge.red {
      background: var(--red);
      color: white;
    }

    .card-body {
      padding: 26px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-body p { color: var(--muted); }

    .card-body .tagline {
      color: var(--blue);
      font-weight: 750;
      font-size: 15px;
      margin-bottom: 12px;
    }

    .card-body ul {
      margin: 0 0 22px;
      padding-left: 20px;
      color: var(--muted);
      font-size: 14px;
    }

    .card-body .btn,
