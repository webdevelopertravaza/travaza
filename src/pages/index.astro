<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Travaza | Toronto &amp; Niagara Tours, Coach Charters &amp; Holiday Transfers</title>

  <meta name="description" content="Explore Toronto and Niagara Falls tours, fall colours and holiday experiences. Request corporate transportation, charter buses and Christmas party transfers.">
  <meta name="theme-color" content="#101817">

  <meta property="og:type" content="website">
  <meta property="og:title" content="Travaza | Tours, Coach Charters & Holiday Experiences">
  <meta property="og:description" content="From Ontario fall colours to festive nights, discover tours and request group transportation with Travaza.">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "TravelAgency",
        "name": "Travaza",
        "email": "reservations@travaza.com",
        "telephone": "+1-866-979-1181",
