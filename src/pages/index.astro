---
const audiences = [
  "Private Clients",
  "Family Offices",
  "Professional Sports",
  "Fortune & Forbes Companies",
  "Musicians & Entertainment",
  "Luxury FIT Travel",
  "Executive Leadership",
  "Tour Operators",
  "Major Events"
];

const services = [
  {
    eyebrow: "PRIVATE TRAVEL",
    title: "Bespoke Journeys",
    description:
      "Highly personalized travel designed around your time, interests, pace and priorities — from one extraordinary day to a complete multi-destination itinerary."
  },
  {
    eyebrow: "CORPORATE",
    title: "Executive Programs",
    description:
      "Leadership retreats, client entertainment, conferences, executive movements and complex travel programs delivered with discretion and precision."
  },
  {
    eyebrow: "EVENTS",
    title: "High-Touch Events",
    description:
      "VIP guest logistics, launches, sporting events, premieres, productions and private experiences where timing and presentation matter."
  },
  {
    eyebrow: "AVIATION",
    title: "Private Aviation",
    description:
      "Private aircraft sourcing coordinated with ground transportation and destination services for a seamless door-to-door journey."
  }
];

const globalMovement = [
  {
    number: "01",
    title: "Private Chauffeur",
    text:
      "Sedans, SUVs and executive vehicles for private clients, airport movements, meetings, evenings and discreet point-to-point travel."
  },
  {
    number: "02",
    title: "Executive Sprinters",
    text:
      "Premium group transportation for families, executives, artists and small groups who want to travel together without sacrificing comfort."
  },
  {
    number: "03",
    title: "Private Motorcoaches",
    text:
      "Full-size and mini coaches for executive programs, sports teams, touring artists, corporate groups and complex private itineraries."
  },
  {
    number: "04",
    title: "Airport & Aviation Coordination",
    text:
      "Arrival and departure programs coordinated around commercial or private aviation, including vehicles, groups and onward movements."
  },
  {
    number: "05",
    title: "Sports & Entertainment",
    text:
      "Transportation and movement planning for teams, athletes, ownership groups, artists, touring productions and VIP guests."
  },
  {
    number: "06",
    title: "Complex Group Movements",
    text:
      "Multi-vehicle, multi-location and time-sensitive logistics coordinated by one team from planning through execution."
  }
];

const guyanaServices = [
  "Curated multi-day experiences",
  "Private tours",
  "Airport transfers",
  "Private transportation",
  "Group shuttles",
  "Hotel packages",
  "Nature & wildlife",
  "Cultural experiences",
  "Corporate programs",
  "Private guides",
  "Custom itineraries",
  "Group travel"
];
---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>

<title>
Travaza | Private Travel, Global Movement & Curated Experiences
</title>

<meta
  name="description"
  content="Travaza creates and executes private travel, global movement, executive transportation, corporate programs, private aviation, yacht experiences, sports team movements and curated journeys worldwide."
/>

<meta
  name="keywords"
  content="luxury travel, private travel, global transportation, private jet charter, yacht charter, executive transportation, sports team transportation, corporate travel, Niagara Falls, Guyana travel, Miami yacht charter"
 />

<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
/>

<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
/>

<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Manrope:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<style>

:root {
  --black: #050605;
  --black-soft: #101210;

  --white: #ffffff;
  --soft-white: #fafafa;

  --gold: #c89a3d;
  --gold-light: #e6c57d;
  --gold-dark: #92702d;

  --text: #171917;
  --muted: #6a6e6a;

  --line: #e5e6e3;
  --dark-line: rgba(255,255,255,.14);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  background: var(--white);
  color: var(--text);

  font-family:
    "Manrope",
    Arial,
    sans-serif;

  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4,
blockquote {
  font-family:
    "Cormorant Garamond",
    Georgia,
    serif;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

input,
select,
textarea,
button {
  font: inherit;
}

.container {
  width: min(1240px, calc(100% - 46px));
  margin: auto;
}

.eyebrow {
  color: var(--gold-dark);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.eyebrow-light {
  color: var(--gold-light);
}

.section-title {
  margin: 14px 0 20px;

  font-size:
    clamp(
      50px,
      6.4vw,
      88px
    );

  line-height: .94;
  font-weight: 400;
  letter-spacing: -.035em;
}

.section-copy {
  max-width: 700px;

  color: var(--muted);

  font-size: 16px;
  line-height: 1.8;
}

.button {
  min-height: 55px;
  padding: 0 26px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .17em;
  text-transform: uppercase;
}

.button-gold {
  background: var(--gold);
  color: #080908;
}

.button-dark {
  background: var(--black);
  color: white;
}

.button-outline {
  border: 1px solid rgba(255,255,255,.35);
  color: white;
}

/* HEADER */

header {
  position: absolute;
  width: 100%;
  z-index: 30;

  border-bottom:
    1px solid
    rgba(255,255,255,.17);
}

.nav {
  min-height: 94px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}

.main-logo {
  width: 190px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 27px;
}

.nav-links a {
  color: rgba(255,255,255,.82);

  font-size: 10px;
  font-weight: 500;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.nav-links a:hover {
  color: var(--gold-light);
}

.nav-cta {
  border: 1px solid rgba(230,197,125,.72);
  padding: 13px 17px;
}

/* HERO */

.hero {
  min-height: 940px;

  display: flex;
  align-items: center;

  position: relative;
  overflow: hidden;

  color: white;

  background:
    radial-gradient(
      circle at 83% 34%,
      rgba(200,154,61,.17),
      transparent 29%
    ),
    linear-gradient(
      120deg,
      #020302,
      #080b08 65%,
      #16130b
    );
}

.hero:before {
  content: "";

  position: absolute;

  width: 670px;
  height: 670px;

  right: -240px;
  top: 150px;

  border-radius: 50%;

  border:
    1px solid
    rgba(200,154,61,.18);
}

.hero-inner {
  position: relative;
  z-index: 2;

  padding-top: 110px;

  max-width: 1060px;
}

.hero h1 {
  margin: 28px 0 37px;

  font-size:
    clamp(
      76px,
      10vw,
      148px
    );

  line-height: .78;
  letter-spacing: -.055em;
  font-weight: 300;
}

.hero h1 span {
  color: var(--gold-light);
  font-style: italic;
}

.hero-copy {
  max-width: 790px;

  color: rgba(255,255,255,.73);

  font-size: 19px;
  line-height: 1.75;
}

.hero-actions {
  margin-top: 39px;

  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.hero-micro {
  margin-top: 80px;
  padding-top: 26px;

  border-top: 1px solid var(--dark-line);

  display: grid;
  grid-template-columns: repeat(4, 1fr);

  gap: 30px;
}

.hero-micro strong {
  display: block;

  color: var(--gold-light);

  font-family:
    "Cormorant Garamond",
    serif;

  font-size: 22px;
  font-weight: 400;

  margin-bottom: 5px;
}

.hero-micro span {
  color: rgba(255,255,255,.48);

  font-size: 11px;
  line-height: 1.5;
}

/* INTRO */

.intro {
  padding: 135px 0;
  background: white;
}

.intro-grid {
  display: grid;
  grid-template-columns: .8fr 1.2fr;

  gap: 105px;
}

.intro-copy {
  color: var(--muted);

  font-size: 18px;
  line-height: 1.9;
}

.intro-copy strong {
  color: var(--text);
  font-weight: 500;
}

.intro-statement {
  margin-top: 33px;
  padding-top: 30px;

  border-top: 1px solid var(--line);

  font-family:
    "Cormorant Garamond",
    serif;

  font-size: 33px;
  line-height: 1.22;
}

/* AUDIENCE */

.audience {
  padding: 32px 0;

  background: var(--soft-white);

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.audience-list {
  display: flex;
  flex-wrap: wrap;

  justify-content: center;

  gap: 16px 39px;
}

.audience-list span {
  color: #585c58;

  font-size: 10px;
  font-weight: 500;
  letter-spacing: .13em;
  text-transform: uppercase;
}

/* PRIVATE EXPERIENCES */

.services {
  padding: 125px 0;
  background: white;
}

.services-intro {
  max-width: 800px;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  margin-top: 58px;

  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.service-card {
  min-height: 385px;

  padding: 43px;

  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);

  display: flex;
  flex-direction: column;

  background: white;
}

.service-card .card-number {
  color: var(--gold-dark);

  font-size: 9px;
  font-weight: 600;
  letter-spacing: .15em;
}

.service-card h3 {
  margin: auto 0 14px;

  font-size: 46px;
  font-weight: 400;
}

.service-card p {
  margin: 0;

  max-width: 490px;

  color: var(--muted);

  line-height: 1.75;
}

/* MIAMI */

.photo-feature {
  min-height: 760px;

  position: relative;

  display: flex;
  align-items: flex-end;

  overflow: hidden;

  color: white;
}

.photo-feature > img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.photo-feature:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.85),
      rgba(0,0,0,.05) 68%
    );
}

.photo-feature-content {
  position: relative;
  z-index: 2;

  max-width: 780px;

  padding-bottom: 75px;
}

.photo-feature h2 {
  margin: 12px 0 14px;

  font-size:
    clamp(
      52px,
      6.8vw,
      90px
    );

  line-height: .92;
  font-weight: 400;
}

.photo-feature p {
  max-width: 630px;

  color: rgba(255,255,255,.8);

  line-height: 1.75;
}

/* DESTINATION INTRO */

.destination-intro {
  padding: 120px 0 65px;

  background: var(--black);
  color: white;
}

.destination-intro .section-copy {
  color: rgba(255,255,255,.6);
}

/* NEW YORK */

.destination-feature {
  min-height: 700px;

  position: relative;

  display: flex;
  align-items: flex-end;

  overflow: hidden;

  color: white;
}

.destination-feature img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.destination-feature:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.9),
      rgba(0,0,0,.06) 70%
    );
}

.destination-feature-content {
  position: relative;
  z-index: 2;

  padding-bottom: 68px;

  max-width: 720px;
}

.destination-feature h2 {
  margin: 11px 0 10px;

  font-size:
    clamp(
      53px,
      7vw,
      92px
    );

  font-weight: 400;
  line-height: .91;
}

.destination-feature p {
  max-width: 630px;

  color: rgba(255,255,255,.76);

  line-height: 1.7;
}

/* LONDON + PARIS */

.city-pair {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  background: black;
}

.city-card {
  min-height: 650px;

  position: relative;

  overflow: hidden;
}

.city-card img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.city-card:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.85),
      rgba(0,0,0,.04) 70%
    );
}

.city-content {
  position: absolute;
  z-index: 2;

  bottom: 45px;
  left: 42px;
  right: 42px;

  color: white;
}

.city-content h3 {
  margin: 8px 0 8px;

  font-size: 59px;
  font-weight: 400;
}

.city-content p {
  max-width: 480px;

  margin: 0;

  color: rgba(255,255,255,.7);

  font-size: 13px;
  line-height: 1.65;
}

/* TORONTO */

.toronto {
  padding: 130px 0;

  background: white;
}

.toronto-grid {
  display: grid;
  grid-template-columns: .7fr 1.3fr;

  gap: 90px;

  align-items: center;
}

.toronto-mark {
  color: var(--gold-dark);

  font-family:
    "Cormorant Garamond",
    serif;

  font-size: 80px;
  line-height: .9;
}

.destination-copy-large {
  color: var(--muted);

  font-size: 17px;
  line-height: 1.8;
}

.micro-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  margin-top: 30px;

  border-top: 1px solid var(--line);
}

.micro-item {
  padding: 17px 3px;

  border-bottom: 1px solid var(--line);

  color: #555a56;

  font-size: 13px;
}

.micro-item:before {
  content: "—";
  color: var(--gold);
  margin-right: 10px;
}

/* NIAGARA */

.niagara {
  padding: 125px 0;

  background: var(--black);
  color: white;
}

.niagara-heading {
  max-width: 760px;

  margin-bottom: 55px;
}

.niagara-heading .section-copy {
  color: rgba(255,255,255,.6);
}

.niagara-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 18px;
}

.niagara-card {
  min-height: 620px;

  position: relative;

  overflow: hidden;
}

.niagara-card img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.niagara-card:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.88),
      rgba(0,0,0,.05) 68%
    );
}

.niagara-content {
  position: absolute;
  z-index: 2;

  bottom: 36px;
  left: 34px;
  right: 34px;
}

.niagara-content h3 {
  margin: 8px 0 7px;

  font-size: 44px;
  font-weight: 400;
}

.niagara-content p {
  max-width: 530px;

  margin: 0;

  color: rgba(255,255,255,.7);

  font-size: 13px;
  line-height: 1.65;
}

/* GUYANA */

.guyana {
  min-height: 820px;

  position: relative;

  display: flex;
  align-items: center;

  overflow: hidden;

  color: white;
}

.guyana-bg {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.guyana:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.9),
      rgba(0,0,0,.35) 62%,
      rgba(0,0,0,.18)
    );
}

.guyana-content {
  position: relative;
  z-index: 2;

  max-width: 720px;

  padding: 85px 0;
}

.year {
  display: inline-block;

  padding: 10px 14px;

  color: var(--gold-light);

  border: 1px solid rgba(230,197,125,.65);

  font-size: 9px;
  letter-spacing: .17em;
}

.guyana h2 {
  margin: 20px 0 20px;

  font-size:
    clamp(
      58px,
      7.3vw,
      100px
    );

  line-height: .89;
  font-weight: 400;
}

.guyana-lead {
  max-width: 650px;

  color: rgba(255,255,255,.82);

  font-size: 19px;
  line-height: 1.75;
}

.guyana-services {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-top: 30px;
}

.guyana-service {
  padding: 9px 11px;

  border: 1px solid rgba(255,255,255,.28);

  color: rgba(255,255,255,.76);

  font-size: 10px;
}

/* EDITORIAL NY */

.editorial-image {
  min-height: 680px;

  position: relative;

  display: flex;
  align-items: center;

  overflow: hidden;
}

.editorial-image img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.editorial-image:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.82),
      rgba(0,0,0,.12)
    );
}

.editorial-content {
  position: relative;
  z-index: 2;

  max-width: 690px;

  color: white;
}

.editorial-content h2 {
  margin: 13px 0 16px;

  font-size:
    clamp(
      52px,
      6vw,
      82px
    );

  font-weight: 400;
  line-height: .94;
}

.editorial-content p {
  color: rgba(255,255,255,.76);
  line-height: 1.75;
}

/* GLOBAL MOVEMENT */

.global-movement {
  padding: 130px 0;

  background: white;
}

.global-movement-header {
  display: grid;
  grid-template-columns: .8fr 1.2fr;

  gap: 100px;

  align-items: end;

  margin-bottom: 70px;
}

.global-movement-lead {
  color: var(--muted);

  font-size: 18px;
  line-height: 1.85;
}

.global-movement-grid {
  border-top: 1px solid var(--line);
}

.movement-row {
  display: grid;
  grid-template-columns: 90px 280px 1fr;

  gap: 35px;

  align-items: center;

  padding: 32px 0;

  border-bottom: 1px solid var(--line);
}

.movement-number {
  color: var(--gold-dark);

  font-size: 9px;
  font-weight: 600;
  letter-spacing: .16em;
}

.movement-row h3 {
  margin: 0;

  font-size: 34px;
  font-weight: 400;
}

.movement-row p {
  margin: 0;

  max-width: 650px;

  color: var(--muted);

  font-size: 13px;
  line-height: 1.7;
}

.movement-closing {
  margin-top: 80px;

  padding: 65px;

  background: var(--black);
  color: white;

  display: grid;
  grid-template-columns: 1fr auto;

  gap: 40px;

  align-items: center;
}

.movement-closing h3 {
  margin: 0;

  font-size:
    clamp(
      38px,
      5vw,
      64px
    );

  font-weight: 400;
  line-height: .98;
}

/* LUXURY STATEMENT */

.luxury-statement {
  padding: 145px 0;

  background: var(--black);
  color: white;

  text-align: center;
}

.luxury-statement blockquote {
  max-width: 1000px;

  margin: 20px auto 0;

  font-size:
    clamp(
      49px,
      6.4vw,
      86px
    );

  line-height: 1;
  font-weight: 400;
}

.luxury-statement blockquote span {
  color: var(--gold-light);
  font-style: italic;
}

/* CONSULTATION */

.consultation {
  padding: 130px 0;

  background: white;
}

.consultation-grid {
  display: grid;
  grid-template-columns: .72fr 1.28fr;

  gap: 95px;
}

.consultation-copy {
  color: var(--muted);
  line-height: 1.8;
}

.direct {
  margin-top: 30px;
  padding-top: 25px;

  border-top: 1px solid var(--line);
}

.direct a {
  font-weight: 600;
}

.form {
  padding: 40px;

  border: 1px solid var(--line);

  background: white;
}

.form h3 {
  margin: 0 0 27px;

  font-size: 40px;
  font-weight: 400;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 17px;
}

.field {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.full {
  grid-column: 1 / -1;
}

label {
  color: #626762;

  font-size: 9px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
}

input,
select,
textarea {
  width: 100%;

  min-height: 51px;

  padding: 12px 13px;

  border: 1px solid #d9dcd9;

  background: #fafafa;

  border-radius: 0;
  outline: none;
}

textarea {
  min-height: 145px;
  resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--gold);
}

.submit {
  width: 100%;

  min-height: 59px;

  margin-top: 19px;

  border: none;

  background: var(--black);
  color: white;

  cursor: pointer;

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
}

/* FOOTER */

footer {
  padding: 68px 0 35px;

  background: var(--black);
  color: white;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr .7fr .7fr;

  gap: 60px;
}

.footer-logo {
  width: 205px;
}

.footer-copy {
  max-width: 460px;

  margin-top: 20px;

  color: rgba(255,255,255,.48);

  font-size: 12px;
  line-height: 1.7;
}

.footer-heading {
  margin-bottom: 17px;

  color: var(--gold-light);

  font-size: 9px;
  letter-spacing: .18em;
}

.footer-links {
  display: flex;
  flex-direction: column;

  gap: 11px;

  color: rgba(255,255,255,.62);

  font-size: 12px;
}

.legal {
  margin-top: 52px;
  padding-top: 23px;

  border-top: 1px solid var(--dark-line);

  color: rgba(255,255,255,.34);

  font-size: 9px;
  line-height: 1.6;
}

/* MOBILE */

@media (max-width: 900px) {

  .nav-links a:not(.nav-cta) {
    display: none;
  }

  .intro-grid,
  .toronto-grid,
  .global-movement-header,
  .consultation-grid {
    grid-template-columns: 1fr;

    gap: 50px;
  }

  .city-pair,
  .niagara-grid {
    grid-template-columns: 1fr;
  }

  .movement-row {
    grid-template-columns: 55px 1fr;

    gap: 20px;
  }

  .movement-row p {
    grid-column: 2;
  }

  .movement-closing {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-grid > div:first-child {
    grid-column: 1 / -1;
  }
}

@media (max-width: 640px) {

  .container {
    width: calc(100% - 28px);
  }

  .nav {
    min-height: 76px;
  }

  .main-logo {
    width: 150px;
  }

  .nav-cta {
    padding: 10px 11px;
  }

  .hero {
    min-height: 850px;
  }

  .hero-inner {
    padding-top: 110px;
  }

  .hero-micro {
    grid-template-columns: repeat(2, 1fr);
  }

  .intro,
  .services,
  .toronto,
  .niagara,
  .global-movement,
  .luxury-statement,
  .consultation {
    padding: 82px 0;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: 340px;
    padding: 28px;
  }

  .photo-feature {
    min-height: 600px;
  }

  .destination-feature {
    min-height: 590px;
  }

  .city-card {
    min-height: 550px;
  }

  .niagara-card {
    min-height: 520px;
  }

  .guyana {
    min-height: 780px;
  }

  .movement-row {
    grid-template-columns: 40px 1fr;
  }

  .movement-closing {
    padding: 40px 28px;
  }

  .form {
    padding: 27px 18px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .full {
    grid-column: auto;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid > div:first-child {
    grid-column: auto;
  }
}

</style>

</head>


<body>


<header>

<div class="container nav">

<a href="/">

<img
  class="main-logo"
  src="/images/travaza/travaza-gold.png"
  alt="Travaza"
/>

</a>


<nav class="nav-links">

<a href="#about">
About
</a>

<a href="#experiences">
Private Travel
</a>

<a href="#destinations">
Destinations
</a>

<a href="#global-movement">
Global Movement
</a>

<a href="#consultation" class="nav-cta">
Private Consultation
</a>

</nav>

</div>

</header>


<main>


<!-- HERO -->

<section class="hero">

<div class="container hero-inner">

<div class="eyebrow eyebrow-light">
PRIVATE TRAVEL • GLOBAL MOVEMENT • CURATED EXPERIENCES
</div>

<h1>
The world,
<br />
<span>handled.</span>
</h1>

<p class="hero-copy">

Travaza creates and executes exceptional private travel,
destination experiences and global movement for private clients,
leading companies, professional sports and entertainment.

</p>

<div class="hero-actions">

<a
  href="#consultation"
  class="button button-gold"
>
Begin Planning
</a>

<a
  href="#destinations"
  class="button button-outline"
>
Explore Travaza
</a>

</div>


<div class="hero-micro">

<div>
<strong>Private Clients</strong>
<span>Travel designed around your time.</span>
</div>

<div>
<strong>Global Organizations</strong>
<span>Executive programs and major movements.</span>
</div>

<div>
<strong>Sports & Entertainment</strong>
<span>Precision logistics for demanding schedules.</span>
</div>

<div>
<strong>Private Experiences</strong>
<span>Aviation, yachts and extraordinary destinations.</span>
</div>

</div>

</div>

</section>


<!-- INTRO -->

<section
  id="about"
  class="intro"
>

<div class="container intro-grid">

<div>

<div class="eyebrow">
THE TRAVAZA APPROACH
</div>

<h2 class="section-title">
Designed around you.
</h2>

</div>


<div class="intro-copy">

<p>

Travaza is a private travel,
global movement and destination company
for people who want the experience
without managing every detail behind it.

</p>

<p>

We bring together

<strong>

transportation,
private aviation,
yachts,
hotels,
guides,
events,
destination expertise
and custom experiences

</strong>

through one trusted relationship.

</p>

<div class="intro-statement">

You enjoy the journey.
We handle everything around it.

</div>

</div>

</div>

</section>


<!-- AUDIENCE -->

<section class="audience">

<div class="container audience-list">

{
  audiences.map(
    audience => (

<span>
{audience}
</span>

    )
  )
}

</div>

</section>


<!-- PRIVATE EXPERIENCES -->

<section
  id="experiences"
  class="services"
>

<div class="container">

<div class="services-intro">

<div class="eyebrow">
PRIVATE & CUSTOM EXPERIENCES
</div>

<h2 class="section-title">
Made for you.
Not everyone.
</h2>

<p class="section-copy">

The best journeys feel personal.
Travaza creates experiences around your interests,
schedule, destination and the way you prefer to travel.

</p>

</div>


<div class="services-grid">

{
  services.map(
    (service, index) => (

<article class="service-card">

<div class="card-number">
0{index + 1}
</div>

<div class="eyebrow" style="margin-top:20px;">
{service.eyebrow}
</div>

<h3>
{service.title}
</h3>

<p>
{service.description}
</p>

</article>

    )
  )
}

</div>

</div>

</section>


<!-- MIAMI -->

<section class="photo-feature">

<img
  src="/images/travaza/miami.png"
  alt="Travaza Miami"
/>

<div class="container photo-feature-content">

<div class="eyebrow eyebrow-light">
MIAMI
</div>

<h2>
Life looks different
from the water.
</h2>

<p>

Private yachts,
chauffeured transportation,
aviation,
VIP events
and curated South Florida experiences.

</p>

</div>

</section>


<!-- DESTINATION INTRO -->

<section
  id="destinations"
  class="destination-intro"
>

<div class="container">

<div class="eyebrow eyebrow-light">
CURATED DESTINATIONS
</div>

<h2 class="section-title">
Local knowledge.
Global ambition.
</h2>

<p class="section-copy">

We don't simply take you somewhere.
We create a way to experience it.

</p>

</div>

</section>


<!-- NEW YORK -->

<section class="destination-feature">

<img
  src="/images/travaza/new-york-2.png"
  alt="New York"
/>

<div class="container destination-feature-content">

<div class="eyebrow eyebrow-light">
NEW YORK • USA
</div>

<h2>
The world's stage.
</h2>

<p>

Executive mobility,
private touring,
corporate programs,
sports,
entertainment
and sophisticated New York experiences
built around your time.

</p>

</div>

</section>


<!-- LONDON + PARIS -->

<section class="city-pair">


<article class="city-card">

<img
  src="/images/travaza/london.png"
