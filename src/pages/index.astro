<html lang="en">


<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>


<title>
Travaza | Luxury Travel, Executive Transportation & Curated Experiences
</title>


<meta
  name="description"
  content="Travaza plans and executes luxury travel, private aviation, yacht experiences, executive transportation, corporate programs, sports team movements and curated destination experiences worldwide."
/>


<meta
  name="keywords"
  content="luxury travel, high net worth travel, executive transportation, private jet charter, yacht charter, corporate travel, sports team transportation, Niagara Falls private tours, Toronto executive transportation, Miami yacht charter, Guyana luxury travel"
/>


<style>


:root {

  --black: #040605;
  --black-soft: #0a0d0b;
  --black-card: #101310;

  --cream: #f5f1e7;
  --cream-soft: #e8e1d4;

  --gold: #cf9b35;
  --gold-light: #edc675;
  --gold-dark: #956a20;

  --white: #ffffff;

  --light-text: rgba(255,255,255,.82);
  --muted-light: rgba(255,255,255,.56);

  --dark-text: #151815;
  --muted-dark: #676b67;

  --light-line: rgba(255,255,255,.12);
  --dark-line: rgba(20,24,21,.13);

}


* {
  box-sizing: border-box;
}


html {
  scroll-behavior: smooth;
}


body {

  margin: 0;

  background: var(--black);

  color: white;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  -webkit-font-smoothing: antialiased;

}


img {

  display: block;

  max-width: 100%;

}


a {

  color: inherit;

  text-decoration: none;

}


input,
textarea,
select,
button {

  font: inherit;

}


.container {

  width:
    min(
      1220px,
      calc(100% - 44px)
    );

  margin: auto;

}


.eyebrow {

  color: var(--gold);

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .2em;

  text-transform: uppercase;

}


.display-heading {

  margin:
    14px
    0
    20px;

  font-size:
    clamp(
      44px,
      6vw,
      80px
    );

  line-height: .99;

  font-weight: 300;

  letter-spacing: -.045em;

}


.section-copy {

  max-width: 720px;

  color: var(--muted-light);

  font-size: 17px;

  line-height: 1.7;

}



/* =========================================
HEADER
========================================= */


header {

  position: absolute;

  width: 100%;

  z-index: 20;

  border-bottom:
    1px solid
    var(--light-line);

}


.nav {

  min-height: 92px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 30px;

}


.logo {

  width: 195px;

}


.nav-links {

  display: flex;

  align-items: center;

  gap: 27px;

}


.nav-links a {

  color: rgba(255,255,255,.72);

  font-size: 11px;

  letter-spacing: .12em;

  text-transform: uppercase;

}


.nav-links a:hover {

  color: var(--gold-light);

}


.nav-button {

  border:
    1px solid
    var(--gold);

  padding:
    13px
    18px;

  color:
    var(--gold-light)
    !important;

}



/* =========================================
HERO
========================================= */


.hero {

  min-height: 920px;

  position: relative;

  display: flex;

  align-items: center;

  overflow: hidden;

  background:

    radial-gradient(
      circle at 80% 36%,
      rgba(207,155,53,.15),
      transparent 28%
    ),

    linear-gradient(
      120deg,
      #020403,
      #090c09 64%,
      #121008
    );

}


.hero:after {

  content: "";

  position: absolute;

  width: 660px;

  height: 660px;

  border-radius: 50%;

  right: -250px;

  top: 145px;

  border:
    1px solid
    rgba(207,155,53,.15);

}


.hero-inner {

  position: relative;

  z-index: 2;

  padding-top: 110px;

  max-width: 1050px;

}


.hero h1 {

  margin:
    26px
    0
    30px;

  font-size:
    clamp(
      63px,
      9.5vw,
      132px
    );

  line-height: .86;

  font-weight: 200;

  letter-spacing: -.07em;

}


.hero .gold {

  color: var(--gold);

}


.hero-description {

  max-width: 820px;

  color: rgba(255,255,255,.69);

  font-size:
    clamp(
      18px,
      2vw,
      23px
    );

  line-height: 1.65;

}


.hero-actions {

  display: flex;

  flex-wrap: wrap;

  gap: 13px;

  margin-top: 39px;

}


.btn {

  min-height: 55px;

  padding:
    0
    26px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .14em;

  text-transform: uppercase;

}


.btn-gold {

  background: var(--gold);

  color: #050705;

}


.btn-gold:hover {

  background: var(--gold-light);

}


.btn-outline {

  border:
    1px solid
    rgba(255,255,255,.28);

}


.btn-outline:hover {

  border-color: var(--gold);

  color: var(--gold-light);

}


.hero-bottom {

  margin-top: 76px;

  padding-top: 27px;

  border-top:
    1px solid
    var(--light-line);

  display: grid;

  grid-template-columns:
    repeat(
      4,
      1fr
    );

  gap: 28px;

}


.hero-stat strong {

  display: block;

  color: var(--gold-light);

  font-size: 15px;

  font-weight: 400;

  margin-bottom: 7px;

}


.hero-stat span {

  color: rgba(255,255,255,.48);

  font-size: 12px;

  line-height: 1.5;

}



/* =========================================
WHO WE ARE
========================================= */


.who {

  padding:
    125px
    0;

  background: var(--cream);

  color: var(--dark-text);

}


.who-grid {

  display: grid;

  grid-template-columns:
    .72fr
    1.28fr;

  gap: 105px;

}


.who-copy {

  color: #545954;

  font-size: 18px;

  line-height: 1.82;

}


.who-copy strong {

  color: var(--dark-text);

}


.promise {

  margin-top: 32px;

  padding-top: 27px;

  border-top:
    1px solid
    var(--dark-line);

  font-size: 25px;

  line-height: 1.4;

  font-weight: 300;

}



/* =========================================
IDEAL CLIENTS
========================================= */


.clients {

  padding:
    120px
    0;

}


.clients-grid {

  display: grid;

  grid-template-columns:
    repeat(
      3,
      1fr
    );

  margin-top: 50px;

  border-top:
    1px solid
    var(--light-line);

  border-left:
    1px solid
    var(--light-line);

}


.client-card {

  min-height: 260px;

  padding: 33px;

  border-right:
    1px solid
    var(--light-line);

  border-bottom:
    1px solid
    var(--light-line);

}


.client-number {

  color: var(--gold);

  font-size: 11px;

  letter-spacing: .15em;

}


.client-card h3 {

  margin:
    60px
    0
    11px;

  font-size: 26px;

  font-weight: 300;

}


.client-card p {

  color: var(--muted-light);

  font-size: 14px;

  line-height: 1.6;

}



/* =========================================
WHAT WE DO
========================================= */


.what {

  padding:
    120px
    0;

  background: #0b0e0c;

}


.division-grid {

  display: grid;

  grid-template-columns:
    repeat(
      2,
      1fr
    );

  margin-top: 55px;

  border-top:
    1px solid
    var(--light-line);

  border-left:
    1px solid
    var(--light-line);

}


.division {

  min-height: 510px;

  padding: 42px;

  border-right:
    1px solid
    var(--light-line);

  border-bottom:
    1px solid
    var(--light-line);

  display: flex;

  flex-direction: column;

}


.division img {

  width: 225px;

  height: 80px;

  object-fit: contain;

  object-position: left center;

}


.division h3 {

  margin:
    auto
    0
    13px;

  font-size: 37px;

  font-weight: 300;

}


.division > p {

  color: var(--muted-light);

  line-height: 1.65;

  max-width: 520px;

}


.mini-services {

  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 22px;

}


.mini-service {

  padding:
    9px
    11px;

  border:
    1px solid
    var(--light-line);

  color:
    rgba(
      255,
      255,
      255,
      .62
    );

  font-size: 11px;

}



/* =========================================
DESTINATIONS
BLACK BY DESIGN
========================================= */


.where {

  padding:
    125px
    0;

  background: var(--black);

  color: white;

}


.where .display-heading {

  color: white;

}


.where .section-copy {

  color: var(--muted-light);

}


.destination-list {

  margin-top: 58px;

  border-top:
    1px solid
    var(--light-line);

}


.destination-row {

  min-height: 205px;

  display: grid;

  grid-template-columns:
    185px
    .8fr
    1.25fr;

  gap: 48px;

  align-items: center;

  padding:
    42px
    0;

  border-bottom:
    1px solid
    var(--light-line);

}


.destination-row img {

  max-width: 160px;

  max-height: 72px;

  object-fit: contain;

  object-position: left center;

}


.destination-logo-fallback {

  width: 160px;

  height: 2px;

  background: var(--gold);

}


.destination-region {

  color: var(--gold);

  font-size: 10px;

  letter-spacing: .17em;

  font-weight: 700;

}


.destination-row h3 {

  margin:
    8px
    0
    0;

  color: white;

  font-size: 32px;

  font-weight: 300;

}


.destination-row .headline {

  color: white;

  font-size: 18px;

  margin-bottom: 8px;

}


.destination-row p {

  margin: 0;

  color: var(--muted-light);

  font-size: 14px;

  line-height: 1.65;

}



/* =========================================
GUYANA FEATURE
========================================= */


.guyana-feature {

  padding:
    125px
    0;

  background:
    linear-gradient(
      125deg,
      #0a0d0b,
      #17160c
    );

}


.guyana-grid {

  display: grid;

  grid-template-columns:
    .8fr
    1.2fr;

  gap: 95px;

  align-items: center;

}


.guyana-brand {

  max-width: 325px;

  margin-bottom: 38px;

}


.year-badge {

  display: inline-block;

  border:
    1px solid
    var(--gold);

  color: var(--gold-light);

  padding:
    10px
    14px;

  font-size: 10px;

  letter-spacing: .17em;

  margin-bottom: 25px;

}


.guyana-feature h2 {

  font-size:
    clamp(
      46px,
      6vw,
      78px
    );

  line-height: .98;

  letter-spacing: -.045em;

  font-weight: 300;

  margin:
    0
    0
    25px;

}


.guyana-lead {

  font-size: 20px;

  line-height: 1.65;

  color: rgba(255,255,255,.72);

}


.guyana-services {

  display: grid;

  grid-template-columns:
    repeat(
      2,
      1fr
    );

  margin-top: 34px;

  border-top:
    1px solid
    var(--light-line);

}


.guyana-service {

  padding:
    17px
    5px;

  border-bottom:
    1px solid
    var(--light-line);

  color: rgba(255,255,255,.72);

  font-size: 13px;

}


.guyana-service:before {

  content: "—";

  color: var(--gold);

  margin-right: 10px;

}



/* =========================================
SIGNATURE EXPERIENCES
========================================= */


.signature {

  padding:
    120px
    0;

  background: var(--cream);

  color: var(--dark-text);

}


.signature .section-copy {

  color: var(--muted-dark);

}


.signature-grid {

  display: grid;

  grid-template-columns:
    repeat(
      3,
      1fr
    );

  margin-top: 50px;

  border-top:
    1px solid
    var(--dark-line);

  border-left:
    1px solid
    var(--dark-line);

}


.signature-card {

  min-height: 330px;

  padding: 33px;

  border-right:
    1px solid
    var(--dark-line);

  border-bottom:
    1px solid
    var(--dark-line);

  display: flex;

  flex-direction: column;

}


.signature-card h3 {

  margin:
    auto
    0
    13px;

  font-size: 28px;

  font-weight: 300;

}


.signature-card p {

  color: var(--muted-dark);

  line-height: 1.65;

  font-size: 14px;

}



/* =========================================
MOVEMENT
========================================= */


.movement {

  padding:
    125px
    0;

}


.movement-grid {

  display: grid;

  grid-template-columns:
    .8fr
    1.2fr;

  gap: 95px;

}


.movement h2 {

  margin:
    13px
    0
    25px;

  font-size:
    clamp(
      43px,
      5vw,
      68px
    );

  line-height: 1.02;

  letter-spacing: -.04em;

  font-weight: 300;

}


.movement-copy {

  color: var(--muted-light);

  font-size: 17px;

  line-height: 1.75;

}


.movement-services {

  display: grid;

  grid-template-columns:
    repeat(
      2,
      1fr
    );

  border-top:
    1px solid
    var(--light-line);

}


.movement-item {

  padding:
    17px
    5px;

  border-bottom:
    1px solid
    var(--light-line);

  color:
    rgba(
      255,
      255,
      255,
      .75
    );

  font-size: 14px;

}


.movement-item:before {

  content: "—";

  color: var(--gold);

  margin-right: 11px;

}



/* =========================================
STATEMENT
========================================= */


.statement {

  padding:
    140px
    0;

  background: var(--cream);

  color: var(--dark-text);

  text-align: center;

}


.statement-inner {

  max-width: 970px;

  margin: auto;

}


.statement blockquote {

  margin:
    22px
    0
    0;

  font-size:
    clamp(
      39px,
      5vw,
      68px
    );

  line-height: 1.08;

  letter-spacing: -.04em;

  font-weight: 300;

}


.statement blockquote span {

  color: var(--gold-dark);

}



/* =========================================
CONTACT
========================================= */


.contact {

  padding:
    125px
    0;

}


.contact-grid {

  display: grid;

  grid-template-columns:
    .75fr
    1.25fr;

  gap: 90px;

}


.contact h2 {

  margin:
    14px
    0
    22px;

  font-size:
    clamp(
      44px,
      5vw,
      69px
