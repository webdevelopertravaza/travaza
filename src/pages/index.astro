          },
          {
            "@type": "Thing",
            "name": "Attraction tickets"
          }
        ]
      }
    ]
  }
  </script>

  <style>
    :root {
      --navy: #101817;
      --blue: #1e4179;
      --red: #c99b3b;
      --red-hover: #b4892f;
      --ink: #142a45;
      --muted: #52647b;
      --pale: #f8f6f0;
      --line: #d9e2ef;
      --radius: 20px;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 95px;
    }

    body {
      margin: 0;
      font: 16px/1.65 system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      color: var(--ink);
      background: #fff;
    }

    a { color: inherit; }

    button, input, select, textarea { font: inherit; }
    button, a { touch-action: manipulation; }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    summary:focus-visible {
      outline: 3px solid #ffbf3f;
      outline-offset: 4px;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1, h2, h3 {
      line-height: 1.12;
      letter-spacing: -.035em;
    }

    h1 {
      font-size: clamp(42px, 5.7vw, 76px);
      max-width: 820px;
      margin-bottom: 22px;
    }

    h2 {
      font-size: clamp(30px, 3.7vw, 46px);
      margin-bottom: 18px;
    }

    h3 {
      font-size: 25px;
      margin-bottom: 12px;
    }

    .wrap {
      max-width: 1240px;
      margin: auto;
      padding: 0 26px;
    }

    .section { padding: 72px 0; }
    .pale { background: var(--pale); }

    .eyebrow {
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: .16em;
      font-weight: 800;
      margin-bottom: 14px;
      color: var(--blue);
    }

    .intro {
      max-width: 800px;
      margin-bottom: 30px;
    }

    .intro > p:last-child {
      font-size: 18px;
      color: var(--muted);
    }

    .small { font-size: 13px; }
    .muted { color: var(--muted); }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 48px;
      padding: 12px 22px;
      background: var(--red);
      border: 1px solid transparent;
      border-radius: 9px;
      color: #fff;
      font-weight: 750;
      text-decoration: none;
      cursor: pointer;
    }

    .btn:hover { background: var(--red-hover); }
    .btn.blue { background: var(--blue); }
    .btn.blue:hover { background: var(--navy); }

    .btn.outline {
      background: transparent;
      border-color: #9cb3d2;
      color: #fff;
    }

    .btn.outline:hover { background: #ffffff18; }

    .actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .text-link {
      color: var(--blue);
      font-weight: 750;
      text-underline-offset: 4px;
    }

    .skip {
      position: absolute;
      left: -9999px;
    }

    .skip:focus {
      left: 16px;
      top: 16px;
      z-index: 100;
      background: white;
      padding: 10px;
    }

    .topbar {
      background: var(--blue);
      color: #fff;
      text-align: center;
      padding: 8px 15px;
      font-size: 12px;
      letter-spacing: .05em;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: #fffffff5;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      min-height: 78px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 31px;
      letter-spacing: -.06em;
      font-weight: 850;
      color: var(--blue);
      text-decoration: none;
    }

    .logo span { color: var(--red); }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
    }

    .nav-links a {
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .menu-toggle {
      display: none;
      background: white;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 13px;
      color: var(--blue);
    }

    .hero {
      position: relative;
      background: var(--navy);
      color: white;
      min-height: 570px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero > img {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
      inset: 0;
    }

    .hero:after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(5, 28, 62, .96),
        rgba(5, 28, 62, .7) 55%,
        rgba(5, 28, 62, .18)
      );
    }

    .hero-content {
      position: relative;
      z-index: 1;
      padding-top: 85px;
      padding-bottom: 85px;
      width: 100%;
    }

    .hero .eyebrow { color: #c6ddff; }

    .hero p:not(.eyebrow) {
      max-width: 670px;
      font-size: 19px;
      color: #e7eef9;
    }

    .hero .actions { margin-top: 28px; }

    .finder {
      background: var(--navy);
      color: white;
    }

    .finder .wrap {
      display: flex;
      gap: 14px;
      align-items: center;
      flex-wrap: wrap;
      padding-top: 20px;
      padding-bottom: 20px;
    }

    .finder strong { margin-right: auto; }

    .finder a {
      border: 1px solid #47648c;
      border-radius: 50px;
      padding: 8px 16px;
      text-decoration: none;
      font-size: 13px;
    }

    .finder a:hover { background: var(--blue); }

    .grid {
      display: grid;
      gap: 24px;
    }

    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tour-card,
    .destination-card {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: white;
      overflow: hidden;
      box-shadow: 0 8px 25px #08264d08;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .photo {
      position: relative;
      background: #dbe7f6;
      overflow: hidden;
    }

    .photo img {
      display: block;
      width: 100%;
      height: 240px;
      object-fit: cover;
      transition: transform .3s;
    }

    .tour-card:hover .photo img,
    .destination-card:hover .photo img {
      transform: scale(1.035);
    }

    .badge {
      position: absolute;
      left: 18px;
      top: 18px;
      background: white;
      color: var(--blue);
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .04em;
    }

    .badge.red {
      background: var(--red);
      color: white;
    }

    .card-body {
      padding: 26px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-body p { color: var(--muted); }

    .card-body .tagline {
      color: var(--blue);
      font-weight: 750;
      font-size: 15px;
      margin-bottom: 12px;
    }

    .card-body ul {
      margin: 0 0 22px;
      padding-left: 20px;
      color: var(--muted);
      font-size: 14px;
    }

    .card-body .btn,
    .card-body > .text-link:last-child {
      margin-top: auto;
    }

    .departure {
      background: var(--pale);
      border-radius: 10px;
      padding: 13px 15px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .departure strong {
      display: block;
      color: var(--blue);
    }

    .book-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      flex-wrap: wrap;
    }

    .booking-box {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px;
      margin: 26px 0;
      box-shadow: 0 10px 35px #08264d06;
    }

    .booking-box h3 { font-size: 26px; }
    .booking-box p { color: var(--muted); }

    .bokunWidget {
      min-height: 140px;
      margin-top: 20px;
    }

    .book-number {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .13em;
      color: var(--red);
      font-weight: 800;
      margin-bottom: 10px;
    }

    .banner {
      background: var(--blue);
      color: white;
      border-radius: var(--radius);
      padding: 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .banner h3 { margin-bottom: 8px; }

    .banner p {
      margin: 0;
      color: #dce9fc;
    }

    .banner .btn { flex-shrink: 0; }
    .trip-card .photo img { height: 290px; }
    .trip-card h3 { font-size: 33px; }
    .trip-card .small { font-size: 13px; }

    .destinations {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .destination-card .photo img { height: 185px; }
    .destination-card h3 { font-size: 25px; }
    .destination-card .card-body { padding: 22px; }
    .destination-card p { font-size: 14px; }
    .destination-card .text-link { font-size: 13px; }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }

    .why-grid > div {
      border-top: 3px solid var(--red);
      padding-top: 20px;
    }

    .why-grid h3 { font-size: 22px; }
    .why-grid p { color: var(--muted); }

    .faq details {
      border-bottom: 1px solid var(--line);
      padding: 20px 0;
    }

    .faq summary {
      font-weight: 750;
      cursor: pointer;
    }

    .faq details p {
      margin: 14px 0 0;
      color: var(--muted);
    }

    .contact {
      background: var(--blue);
      color: white;
    }

    .contact .eyebrow { color: #c2d9fb; }
    .contact p { color: #e0eafa; }

    .contact a {
      color: #fff;
      overflow-wrap: anywhere;
    }

    .contact-form {
      padding: 28px;
      border-radius: var(--radius);
      background: white;
      color: var(--ink);
    }

    .contact-form label {
      display: block;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 6px;
    }

    .field { margin-bottom: 17px; }

    .contact-form input,
    .contact-form select,
    .contact-form textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #bfcde0;
      border-radius: 8px;
      color: var(--ink);
      background: white;
    }

    .contact-form textarea {
      min-height: 110px;
      resize: vertical;
    }

    .contact-form .btn { width: 100%; }
    .contact-form p { color: var(--muted); }

    .footer {
      background: var(--navy);
      color: white;
      padding: 45px 0 22px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 30px;
    }

    .footer .logo { color: white; }

    .footer h3 {
      font-size: 16px;
      letter-spacing: 0;
    }

    .footer p {
      color: #c5d5ec;
      font-size: 14px;
    }

    .footer a {
      display: block;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 9px;
    }

    .footer .logo { font-size: 30px; }

    .footer-bottom {
      border-top: 1px solid #345073;
      margin-top: 25px;
      padding-top: 20px;
      color: #c5d5ec;
      font-size: 12px;
    }

    .credits {
      margin-top: 18px;
      font-size: 11px;
      color: #c5d5ec;
    }

    .credits summary { cursor: pointer; }
    .credits ul { padding-left: 18px; }

    .credits a {
      display: inline;
      text-decoration: underline;
      font-size: 11px;
    }

    .credits li { margin: 6px 0; }

    @media (max-width: 950px) {
      .three { grid-template-columns: 1fr 1fr; }

      .three > .tour-card:last-child {
        grid-column: 1 / -1;
      }

      .destinations { grid-template-columns: 1fr 1fr; }
      .nav-links { gap: 13px; }
      .nav-links a { font-size: 12px; }
      .hero { min-height: 510px; }

      .hero:after {
        background: linear-gradient(90deg, #051c3eee, #051c3e88);
      }
    }

    @media (max-width: 680px) {
      .wrap { padding: 0 20px; }
      .section { padding: 48px 0; }

      .nav {
        min-height: 70px;
        flex-wrap: wrap;
      }

      .menu-toggle { display: block; }

      .nav-links {
        width: 100%;
        flex-wrap: wrap;
        padding-bottom: 16px;
      }

      .header.enhanced .nav-links { display: none; }

      .header.enhanced .nav-links.is-open {
        display: flex;
      }

      .nav-links a { font-size: 14px; }
      .hero { min-height: 520px; }

      .hero-content {
        padding-top: 65px;
        padding-bottom: 65px;
      }

      .hero p:not(.eyebrow) { font-size: 17px; }

      .three, .two, .destinations, .why-grid {
        grid-template-columns: 1fr;
      }

      .three > .tour-card:last-child {
        grid-column: auto;
      }

      .photo img { height: 220px; }
      .destination-card .photo img { height: 210px; }
      .booking-box { padding: 22px 14px; }

      .banner {
        align-items: flex-start;
        flex-direction: column;
        padding: 24px;
      }

      .finder strong { width: 100%; }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-grid > div:first-child {
        grid-column: 1 / -1;
      }

      .contact-form { padding: 22px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .photo img { transition: none; }

      .tour-card:hover .photo img,
      .destination-card:hover .photo img {
        transform: none;
      }
    }

    /* Travaza identity: black, gold and Gray Line blue */
    .brand-logo { display:block; width:280px; height:auto; max-width:100%; }
    .logo { flex-shrink:0; }
    .footer .logo { display:inline-block; background:#fff; padding:14px; border-radius:8px; }
    .btn:not(.blue):not(.outline), .badge.red { color:#101817; }
    .topbar { background:#101817; color:#ebcf92; }
    .hero:after { background:linear-gradient(90deg,rgba(16,24,23,.96),rgba(16,24,23,.75) 55%,rgba(16,24,23,.35)); }
    .hero .eyebrow { color:#ebcf92; }
    .hero h1 { font-size:clamp(40px,5.2vw,68px); }
    .book-number { color:#72500a; }
    .seasonal-card { border:1px solid #e5d9c0; border-radius:20px; padding:30px; display:flex; flex-direction:column; background:#fff; }
    .seasonal-card h3 { font-size:30px; }
    .seasonal-card p:not(.eyebrow) { color:var(--muted); }
    .seasonal-card .btn, .seasonal-card .actions { margin-top:auto; }
    .seasonal-card .actions { align-items:center; }
    .seasonal-card.autumn { border-top:5px solid #ab622a; }
    .seasonal-card.festive { border-top:5px solid #204c3b; }
    .seasonal-card.celebration { border-top:5px solid #c99b3b; }
    .booking-nav { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:30px; }
    .booking-nav a { text-decoration:none; border:1px solid #bdc8d7; border-radius:8px; padding:10px 16px; background:#fff; font-weight:700; color:var(--blue); }
    .booking-nav a:hover { background:var(--blue); color:#fff; }
    .corporate-section { background:#101817; color:#fff; }
    .corporate-section .eyebrow { color:#ebcf92; }
    .corporate-section .intro > p:last-child { color:#cfd8d4; }
    .service-card { border:1px solid #43504b; padding:28px; border-radius:16px; display:flex; flex-direction:column; }
    .service-card h3 { color:#f0d69f; font-size:25px; }
    .service-card p { color:#d4ded9; }
    .service-card .text-link { color:#f0d69f; margin-top:auto; }
    .quote-band { margin-top:30px; padding:28px; border:1px solid #a17c36; border-radius:16px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .quote-band p { color:#d4ded9; margin:0; }
    .quote-band .btn { flex-shrink:0; }
    .contact-phone { display:inline-block; font-weight:800; font-size:24px; margin-bottom:16px; }
    @media(max-width:1100px) { .brand-logo { width:220px; } .nav-links { gap:12px; } .nav-links a { font-size:12px; } }
    @media(max-width:680px) { .brand-logo { width:230px; } .quote-band { flex-direction:column; align-items:flex-start; } .booking-nav a { flex:1 1 100%; } .seasonal-card { padding:24px; } .nav-links a { font-size:14px; } }
  </style>
</head>

<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="topbar">
    FALL COLOURS · HOLIDAY EXPERIENCES · CORPORATE TRANSPORTATION · COACH CHARTERS
  </div>

  <header class="header" id="site-header">
    <nav class="wrap nav" aria-label="Main navigation">
      <a class="logo" href="#" aria-label="Travaza home"><img src="data:image/png;base64," width="2048" height="455" alt="Travaza — Gray Line, VIP Ontario Tours and ATS" class="brand-logo"></a>

      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-controls="nav-links"
        aria-expanded="false"
      >Menu</button>

      <div class="nav-links" id="nav-links">
        <a href="#seasonal">Fall &amp; Christmas</a>
        <a href="#book-toronto">Toronto tours</a>
        <a href="#book-niagara">Niagara tours</a>
        <a href="#corporate">Coach charters</a>
        <a class="btn" href="#contact">Request a quote</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/NiagaraFallsPanorama.jpg?width=1600"
        alt="Panoramic Niagara Falls scenery viewed from Canada"
        width="960"
        height="640"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      >

      <div class="wrap hero-content">
        <p class="eyebrow">
          Gray Line · VIP Ontario Tours · Aligned Transportation Services
        </p>

        <h1>
          Autumn escapes.<br>
          Festive nights.<br>
          Better journeys together.
        </h1>

        <p>
          Discover Toronto and Niagara Falls, escape into Ontario’s fall colours,
          or bring everyone together for a holiday celebration. From a day
          worth remembering to corporate coach transportation, start with Travaza.
        </p>

        <div class="actions">
          <a class="btn" href="#book-tours">
            Find your tour &amp; book ↗
          </a>
          <a class="btn outline" href="#corporate">
            Plan group transportation
          </a>
        </div>
      </div>
    </section>

    <div class="finder">
      <div class="wrap">
        <strong>What kind of day are you looking for?</strong>
        <a href="#tours">Niagara Falls</a>
        <a href="#toronto-city">Toronto city tours</a>
        <a href="#tickets">Attraction tickets</a>
        <a href="#seasonal">Fall colours &amp; Christmas</a>
        <a href="#corporate">Corporate &amp; coach charters</a>
      </div>
    </div>


    <section class="section pale" id="seasonal">
      <div class="wrap">
        <div class="intro">
          <p class="eyebrow">Make room for something memorable</p>
          <h2>Fall colours now. Christmas memories next.</h2>
          <p>Trade another ordinary day for crisp forest air, sparkling Falls views or a festive outing with your favourite people.</p>
        </div>
        <div class="grid three seasonal-grid">
          <article class="seasonal-card autumn">
            <p class="eyebrow">Ontario autumn escapes</p>
            <h3>Follow the fall colours to Algonquin.</h3>
            <p>Leave the city behind for scenic trails, fresh air and Ontario’s changing autumn landscape. See available departure dates and the full shuttle details before booking.</p>
            <a class="btn" href="https://graylinetoronto.com/tours/algonquin-fall-foliage-shuttle-from-toronto" target="_blank" rel="noopener">View fall colours dates ↗</a>
          </article>
          <article class="seasonal-card festive">
            <p class="eyebrow">Niagara holiday experiences</p>
            <h3>A night that sparkles at the Falls.</h3>
            <p>Plan a winter escape around Niagara’s Festival of Lights and illuminated Falls. Choose your departure location and review seasonal dates and package inclusions.</p>
            <div class="actions">
              <a class="btn" href="https://graylinetoronto.com/#tour-panel" target="_blank" rel="noopener">Explore from Toronto ↗</a>
              <a class="text-link" href="#niagara-canada">Explore from Niagara →</a>
