---
const collections = [
  {
    title: "Golf Packages",
    kicker: "PLAY SOMEWHERE EXTRAORDINARY",
    description:
      "Championship courses, luxury accommodations and curated golf escapes designed around the way you want to travel.",
    image: "/images/travaza-luxury.png",
  },
  {
    title: "Spa & Wellness",
    kicker: "REST. RESET. RETURN.",
    description:
      "Luxury spa retreats, wellness weekends and restorative escapes in exceptional destinations around the world.",
    image: "/images/travaza-luxury.png",
  },
  {
    title: "Weekend Getaways",
    kicker: "ESCAPE FOR A WHILE",
    description:
      "Curated city stays, romantic weekends, culinary escapes and spontaneous luxury getaways.",
    image: "/images/travaza-miami.png",
  },
  {
    title: "Private Aviation",
    kicker: "FLY YOUR WAY",
    description:
      "Private aviation and bespoke air travel coordinated around your schedule, destination and experience.",
    image: "/images/travaza-aviation.png",
  },
  {
    title: "Corporate Retreats",
    kicker: "GO FURTHER TOGETHER",
    description:
      "Destination retreats, leadership experiences and team escapes designed to bring people together.",
    image: "/images/travaza-corporate.png",
  },
  {
    title: "Transportation",
    kicker: "MOVE EFFORTLESSLY",
    description:
      "Executive vehicles, private drivers, airport transfers, group shuttles and highway coaches coordinated from beginning to end.",
    image: "/images/travaza-events.png",
  },
];

const trending = [
  {
    title: "Aurora Borealis",
    location: "Canada & Iceland",
    kicker: "CHASE THE NORTHERN LIGHTS",
    description:
      "Remote landscapes, dark skies and extraordinary nights. Let us create a Northern Lights journey worth travelling for.",
    image: "/images/travaza-luxury.png",
  },
  {
    title: "Fall Colours",
    location: "Canada",
    kicker: "CANADA IN COLOUR",
    description:
      "Experience Canada's spectacular autumn landscapes through private touring, countryside escapes and curated seasonal journeys.",
    image: "/images/travaza-niagara.png",
  },
  {
    title: "Québec City",
    location: "Québec, Canada",
    kicker: "OLD WORLD. CLOSE TO HOME.",
    description:
      "Historic streets, remarkable cuisine, beautiful hotels and unmistakable European character without leaving Canada.",
    image: "/images/travaza-toronto.png",
  },
];

const destinations = [
  "Canada",
  "USA",
  "Thailand",
  "Switzerland",
  "Italy",
  "Greece",
  "London",
  "Paris",
  "Japan",
  "Iceland",
  "South Africa",
  "Guyana",
];

const corporateServices = [
  "Corporate Events",
  "Conference Services",
  "Corporate Retreats",
  "Team Building Experiences",
  "Transportation & Shuttles",
  "Step-On Guides",
  "Airport Meet & Greets",
  "VIP Transportation",
