  <script
    src="https://viptours.checkfront.com/lib/interface--0.js"
  ></script>

  <script>
    (function () {
      var header = document.getElementById('site-header');
      var toggle = document.getElementById('menu-toggle');
      var links = document.getElementById('nav-links');

      header.classList.add('enhanced');

      toggle.addEventListener('click', function () {
        var open =
          toggle.getAttribute('aria-expanded') !== 'true';

        toggle.setAttribute('aria-expanded', String(open));
        links.classList.toggle('is-open', open);
      });

      links.addEventListener('click', function (event) {
        if (event.target.closest('a')) {
          links.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });

      document.getElementById('current-year').textContent =
        String(new Date().getFullYear());

      document.getElementById('enquiry-form')
        .addEventListener('submit', function (event) {
          event.preventDefault();

          var name =
            document.getElementById('guest-name').value.trim();

          var email =
            document.getElementById('guest-email').value.trim();

          var interest =
            document.getElementById('trip-interest').value;

          var message =
            document.getElementById('trip-message').value.trim();

          var body =
            'Hello Travaza,\n\nName: ' + name +
            '\nEmail: ' + email +
            '\nInterest: ' + interest +
            '\n\n' + message;

          window.location.href =
            'mailto:reservations@travaza.com?subject=' +
            encodeURIComponent('Travaza enquiry: ' + interest) +
            '&body=' +
            encodeURIComponent(body);

          document.getElementById('email-status').textContent =
            'Your email app should open with a draft. ' +
            'Press Send there to submit your enquiry. ' +
            'If it does not open, email ' +
            'reservations@travaza.com directly.';
        });

      try {
        if (
          window.DROPLET &&
          typeof window.DROPLET.Widget === 'function'
        ) {
          new window.DROPLET.Widget({
            host: 'viptours.checkfront.com',
            target: 'CHECKFRONT_WIDGET_01',
            category_id: '12',
            options: 'tabs',
            provider: 'droplet'
          }).render();
        }
      } catch (error) {
        document.getElementById('CHECKFRONT_WIDGET_01')
          .textContent =
            'Please use the ticket booking button above ' +
            'to check availability.';
      }
    }());
  </script>
