---
const services = [
  {
    title: "Corporate",
    subtitle: "TRAVAZA CORPORATE",
    logo: "/images/travaza/travaza-corporate.png",
    description:
      "Executive transportation, leadership retreats, client entertainment, incentive programs, conferences and high-touch corporate travel.",
    link: "#consultation"
  },
  {
    title: "Events",
    subtitle: "TRAVAZA EVENTS",
    logo: "/images/travaza/travaza-events.png",
    description:
      "VIP event movements, launches, premieres, sporting events, productions, executive dinners and complex guest logistics.",
    link: "#consultation"
  },
  {
    title: "Private Travel",
    subtitle: "TRAVAZA LUXURY",
    logo: "/images/travaza/travaza-luxury.png",
    description:
      "Bespoke journeys designed around privacy, access, time and the way you actually want to experience a destination.",
    link: "#consultation"
  },
  {
    title: "Private Aviation",
    subtitle: "TRAVAZA AVIATION",
    logo: "/images/travaza/travaza-aviation.png",
    description:
      "Private aircraft sourcing paired with executive ground transportation and complete destination coordination.",
    link: "#consultation"
  }
];

const audiences = [
  "Private Clients",
  "Family Offices",
  "Professional Sports",
  "Fortune & Forbes Companies",
  "Musicians & Entertainment",
  "Luxury FIT Travel",
  "Executive Leadership",
  "Tour Operators",
  "Major Events"
];

const mobilityServices = [
  "Worldwide motorcoach charters",
  "Executive Sprinter transportation",
  "Private chauffeur service",
  "Airport transfers",
  "Corporate shuttle programs",
  "Professional sports teams",
  "Athletes & ownership groups",
  "Touring musicians",
  "Entertainment productions",
  "Conference transportation",
  "Executive retreats",
  "Client entertainment",
  "Large group movements",
  "Cross-border transportation",
  "Multi-day touring",
  "Step-on guides",
  "Audio-guided experiences",
  "Private destination guides",
  "FIT transportation",
  "Custom multi-city logistics"
];

const guyanaServices = [
  "Curated multi-day experiences",
  "Private tours",
  "Airport transfers",
  "Private transportation",
  "Group shuttles",
  "Hotel packages",
  "Nature & wildlife experiences",
  "Cultural experiences",
  "Corporate movements",
  "Private guides",
  "Custom itineraries",
  "Group travel programs"
];
---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>

<title>
Travaza | Private Travel, Global Mobility & Curated Experiences
</title>

<meta
  name="description"
  content="Travaza creates and executes private travel, executive transportation, corporate programs, luxury experiences, private aviation, yacht charters, sports team movements and curated journeys worldwide."
/>

<meta
  name="keywords"
  content="luxury travel, high net worth travel, private jet charter, yacht charter, executive transportation, worldwide coach charter, corporate travel, sports team transportation, Niagara Falls private tours, Toronto transportation, Guyana luxury travel, Miami yacht charter"
/>

<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
/>

<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
/>

<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Manrope:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<style>

:root {
  --black: #050605;
  --soft-black: #101210;
  --white: #ffffff;
  --soft-white: #fafafa;

  --gold: #c89a3d;
  --gold-light: #e6c57d;
  --gold-dark: #92702d;

  --text: #171917;
  --muted: #686d69;

  --line: #e7e7e4;
  --dark-line: rgba(255,255,255,.14);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--white);
  color: var(--text);

  font-family:
    "Manrope",
    Arial,
    sans-serif;

  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
h4,
blockquote {
  font-family:
    "Cormorant Garamond",
    Georgia,
    serif;
}

img {
  display: block;
  max-width: 100%;
}

a {
  text-decoration: none;
  color: inherit;
}

input,
select,
textarea,
button {
  font: inherit;
}

.container {
  width: min(1240px, calc(100% - 46px));
  margin: auto;
}

.eyebrow {
  color: var(--gold-dark);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.eyebrow-light {
  color: var(--gold-light);
}

.section-title {
  margin: 14px 0 20px;

  font-size:
    clamp(
      50px,
      6.4vw,
      88px
    );

  line-height: .94;
  font-weight: 400;
  letter-spacing: -.035em;
}

.section-copy {
  max-width: 690px;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
}

.button {
  min-height: 55px;
  padding: 0 26px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .17em;
  text-transform: uppercase;

  transition: .2s ease;
}

.button-gold {
  background: var(--gold);
  color: #080908;
}

.button-gold:hover {
  background: var(--gold-light);
}

.button-dark {
  background: var(--black);
  color: white;
}

.button-outline {
  border: 1px solid rgba(255,255,255,.35);
  color: white;
}


/* ========================================
HEADER
======================================== */

header {
  position: absolute;
  width: 100%;
  z-index: 30;

  border-bottom:
    1px solid
    rgba(255,255,255,.17);
}

.nav {
  min-height: 94px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 30px;
}

.main-logo {
  width: 190px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 27px;
}

.nav-links a {
  color: rgba(255,255,255,.82);

  font-size: 10px;
  font-weight: 500;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.nav-links a:hover {
  color: var(--gold-light);
}

.nav-cta {
  border: 1px solid rgba(230,197,125,.72);
  padding: 13px 17px;
}


/* ========================================
HERO
======================================== */

.hero {
  min-height: 940px;

  display: flex;
  align-items: center;

  position: relative;
  overflow: hidden;

  color: white;

  background:
    radial-gradient(
      circle at 83% 34%,
      rgba(200,154,61,.17),
      transparent 29%
    ),
    linear-gradient(
      120deg,
      #020302,
      #080b08 65%,
      #16130b
    );
}

.hero:before {
  content: "";

  position: absolute;

  width: 670px;
  height: 670px;

  right: -240px;
  top: 150px;

  border-radius: 50%;

  border:
    1px solid
    rgba(200,154,61,.18);
}

.hero-inner {
  position: relative;
  z-index: 2;

  padding-top: 110px;

  max-width: 1070px;
}

.hero h1 {
  margin: 28px 0 37px;

  font-size:
    clamp(
      76px,
      10vw,
      148px
    );

  line-height: .78;
  letter-spacing: -.055em;
  font-weight: 300;
}

.hero h1 span {
  color: var(--gold-light);
  font-style: italic;
}

.hero-copy {
  max-width: 780px;

  color: rgba(255,255,255,.73);

  font-size: 19px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;

  margin-top: 39px;
}

.hero-micro {
  margin-top: 80px;
  padding-top: 26px;

  border-top: 1px solid var(--dark-line);

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.hero-micro strong {
  display: block;
  color: var(--gold-light);

  font-family:
    "Cormorant Garamond",
    serif;

  font-size: 22px;
  font-weight: 400;

  margin-bottom: 5px;
}

.hero-micro span {
  color: rgba(255,255,255,.48);
  font-size: 11px;
  line-height: 1.5;
}


/* ========================================
INTRO
======================================== */

.intro {
  background: white;
  padding: 135px 0;
}

.intro-grid {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 105px;
}

.intro-copy {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.9;
}

.intro-copy strong {
  color: var(--text);
  font-weight: 500;
}

.intro-statement {
  margin-top: 33px;
  padding-top: 30px;

  border-top: 1px solid var(--line);

  font-family:
    "Cormorant Garamond",
    serif;

  font-size: 33px;
  line-height: 1.22;
}


/* ========================================
AUDIENCE
======================================== */

.audience {
  padding: 32px 0;

  background: var(--soft-white);

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.audience-list {
  display: flex;
  flex-wrap: wrap;

  justify-content: center;

  gap: 16px 39px;
}

.audience-list span {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .13em;
  text-transform: uppercase;
  color: #585c58;
}


/* ========================================
SERVICES
======================================== */

.services {
  padding: 125px 0;
  background: white;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  margin-top: 55px;

  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.service-card {
  min-height: 430px;

  padding: 42px;

  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);

  display: flex;
  flex-direction: column;

  background: white;
}

.service-logo {
  width: 220px;
  height: 82px;

  object-fit: contain;
  object-position: left center;
}

.service-card h3 {
  margin: auto 0 12px;

  font-size: 44px;
  font-weight: 400;
}

.service-card p {
  color: var(--muted);
  line-height: 1.75;
  margin-bottom: 23px;
}

.card-link {
  color: var(--gold-dark);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
}


/* ========================================
MIAMI FEATURE
======================================== */

.photo-feature {
  min-height: 760px;

  position: relative;

  display: flex;
  align-items: flex-end;

  overflow: hidden;

  color: white;
}

.photo-feature > img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.photo-feature:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.85),
      rgba(0,0,0,.05) 68%
    );
}

.photo-feature-content {
  position: relative;
  z-index: 2;

  max-width: 780px;

  padding-bottom: 75px;
}

.photo-feature h2 {
  margin: 12px 0 14px;

  font-size:
    clamp(
      52px,
      6.8vw,
      90px
    );

  line-height: .92;
  font-weight: 400;
}

.photo-feature p {
  max-width: 630px;

  color: rgba(255,255,255,.8);

  line-height: 1.75;
}


/* ========================================
DESTINATION INTRO
======================================== */

.destination-intro {
  padding: 120px 0 65px;
  background: var(--black);
  color: white;
}

.destination-intro .section-copy {
  color: rgba(255,255,255,.6);
}


/* ========================================
NEW YORK
======================================== */

.destination-feature {
  position: relative;

  min-height: 700px;

  display: flex;
  align-items: flex-end;

  overflow: hidden;

  color: white;
}

.destination-feature img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.destination-feature:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.9),
      rgba(0,0,0,.06) 70%
    );
}

.destination-feature-content {
  position: relative;
  z-index: 2;

  padding-bottom: 68px;

  max-width: 720px;
}

.destination-feature h2 {
  margin: 11px 0 10px;

  font-size:
    clamp(
      53px,
      7vw,
      92px
    );

  font-weight: 400;
  line-height: .91;
}

.destination-feature p {
  max-width: 630px;

  color: rgba(255,255,255,.76);

  line-height: 1.7;
}


/* ========================================
LONDON + PARIS
======================================== */

.city-pair {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  background: black;
}

.city-card {
  min-height: 650px;

  position: relative;

  overflow: hidden;
}

.city-card img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.city-card:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.85),
      rgba(0,0,0,.04) 70%
    );
}

.city-content {
  position: absolute;
  z-index: 2;

  bottom: 45px;
  left: 42px;
  right: 42px;

  color: white;
}

.city-content h3 {
  margin: 8px 0 8px;

  font-size: 59px;
  font-weight: 400;
}

.city-content p {
  max-width: 480px;

  margin: 0;

  color: rgba(255,255,255,.7);

  font-size: 13px;
  line-height: 1.65;
}


/* ========================================
TORONTO
======================================== */

.toronto {
  padding: 130px 0;
  background: white;
}

.toronto-grid {
  display: grid;
  grid-template-columns: .65fr 1.35fr;

  gap: 90px;

  align-items: center;
}

.destination-brand {
  max-width: 330px;
}

.destination-copy-large {
  color: var(--muted);
  line-height: 1.8;
  font-size: 17px;
}

.micro-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  margin-top: 30px;

  border-top: 1px solid var(--line);
}

.micro-item {
  padding: 17px 3px;

  border-bottom: 1px solid var(--line);

  color: #555a56;

  font-size: 13px;
}

.micro-item:before {
  content: "—";
  color: var(--gold);
  margin-right: 10px;
}


/* ========================================
NIAGARA PHOTO SPLIT
======================================== */

.niagara {
  background: var(--black);
  color: white;
  padding: 125px 0;
}

.niagara-heading {
  max-width: 750px;
  margin-bottom: 55px;
}

.niagara-heading .section-copy {
  color: rgba(255,255,255,.6);
}

.niagara-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 18px;
}

.niagara-card {
  min-height: 620px;

  position: relative;

  overflow: hidden;
}

.niagara-card img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.niagara-card:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      0deg,
      rgba(0,0,0,.88),
      rgba(0,0,0,.05) 68%
    );
}

.niagara-content {
  position: absolute;
  z-index: 2;

  bottom: 36px;
  left: 34px;
  right: 34px;
}

.niagara-content h3 {
  margin: 8px 0 7px;

  font-size: 44px;
  font-weight: 400;
}

.niagara-content p {
  max-width: 530px;

  margin: 0;

  color: rgba(255,255,255,.7);

  font-size: 13px;
  line-height: 1.65;
}


/* ========================================
GUYANA FULL IMAGE
======================================== */

.guyana {
  min-height: 820px;

  position: relative;

  display: flex;
  align-items: center;

  overflow: hidden;

  color: white;
}

.guyana-bg {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.guyana:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.9),
      rgba(0,0,0,.35) 62%,
      rgba(0,0,0,.18)
    );
}

.guyana-content {
  position: relative;
  z-index: 2;

  max-width: 720px;

  padding: 85px 0;
}

.guyana-logo {
  max-width: 290px;
  margin-bottom: 26px;
}

.year {
  display: inline-block;

  color: var(--gold-light);

  border: 1px solid rgba(230,197,125,.65);

  padding: 10px 14px;

  font-size: 9px;
  letter-spacing: .17em;
}

.guyana h2 {
  margin: 20px 0 20px;

  font-size:
    clamp(
      58px,
      7.3vw,
      100px
    );

  line-height: .89;
  font-weight: 400;
}

.guyana-lead {
  max-width: 650px;

  color: rgba(255,255,255,.82);

  font-size: 19px;
  line-height: 1.75;
}

.guyana-services {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-top: 30px;
}

.guyana-service {
  border: 1px solid rgba(255,255,255,.28);

  padding: 9px 11px;

  font-size: 10px;
  color: rgba(255,255,255,.76);
}


/* ========================================
SECOND NEW YORK IMAGE / EDITORIAL
======================================== */

.editorial-image {
  min-height: 680px;

  position: relative;

  display: flex;
  align-items: center;

  overflow: hidden;
}

.editorial-image img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.editorial-image:after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.82),
      rgba(0,0,0,.12)
    );
}

.editorial-content {
  position: relative;
  z-index: 2;

  max-width: 690px;

  color: white;
}

.editorial-content h2 {
  margin: 13px 0 16px;

  font-size:
    clamp(
      52px,
      6vw,
      82px
    );

  font-weight: 400;
  line-height: .94;
}

.editorial-content p {
  color: rgba(255,255,255,.76);
  line-height: 1.75;
}


/* ========================================
GLOBAL MOBILITY
======================================== */

.mobility {
  padding: 130px 0;
  background: white;
}

.mobility-grid {
  display: grid;
  grid-template-columns: .75fr 1.25fr;

  gap: 95px;
}

.mobility-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  border-top: 1px solid var(--line);
}

.mobility-item {
  padding: 17px 4px;

  border-bottom: 1px solid var(--line);

  color: #565b57;
  font-size: 13px;
}

.mobility-item:before {
  content: "—";
  color: var(--gold);
  margin-right: 11px;
}


/* ========================================
LUXURY STATEMENT
======================================== */

.luxury-statement {
  background: var(--black);
  color: white;

  padding: 145px 0;

  text-align: center;
}

.luxury-statement blockquote {
  max-width: 1000px;

  margin: 20px auto 0;

  font-size:
    clamp(
      49px,
      6.4vw,
      86px
    );

  line-height: 1;
  font-weight: 400;
}

.luxury-statement blockquote span {
  color: var(--gold-light);
  font-style: italic;
}


/* ========================================
CONSULTATION
======================================== */

.consultation {
  background: white;

  padding: 130px 0;
}

.consultation-grid {
  display: grid;
  grid-template-columns: .72fr 1.28fr;

  gap: 95px;
}

.consultation-copy {
  color: var(--muted);
  line-height: 1.8;
}

.direct {
  margin-top: 30px;
  padding-top: 25px;

  border-top: 1px solid var(--line);
}

.direct a {
  font-weight: 600;
}

.form {
  background: white;

  border: 1px solid var(--line);

  padding: 40px;
}

.form h3 {
  margin: 0 0 27px;

  font-size: 40px;
  font-weight: 400;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 17px;
}

.field {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.full {
  grid-column: 1 / -1;
}

label {
  color: #626762;

  font-size: 9px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
}

input,
select,
textarea {
  width: 100%;

  min-height: 51px;

  padding: 12px 13px;

  border: 1px solid #d9dcd9;

  background: #fafafa;

  border-radius: 0;
  outline: none;
}

textarea {
  min-height: 145px;
  resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--gold);
}

.submit {
  width: 100%;

  min-height: 59px;

  margin-top: 19px;

  border: none;

  background: var(--black);
  color: white;

  cursor: pointer;

  font-size: 10px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.form-note {
  margin-top: 13px;

  color: #777b77;

  font-size: 10px;
  line-height: 1.5;
}


/* ========================================
FOOTER
======================================== */

footer {
  padding: 68px 0 35px;

  background: var(--black);
  color: white;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr .7fr .7fr;

  gap: 60px;
}

.footer-logo {
  width: 205px;
}

.footer-copy {
  max-width: 460px;

  margin-top: 20px;

  color: rgba(255,255,255,.48);

  font-size: 12px;
  line-height: 1.7;
}

.footer-heading {
  color: var(--gold-light);

  font-size: 9px;
  letter-spacing: .18em;

  margin-bottom: 17px;
}

.footer-links {
  display: flex;
  flex-direction: column;

  gap: 11px;

  color: rgba(255,255,255,.62);

  font-size: 12px;
}

.legal {
  margin-top: 52px;
  padding-top: 23px;

  border-top: 1px solid var(--dark-line);

  color: rgba(255,255,255,.34);

  font-size: 9px;
  line-height: 1.6;
}


/* ========================================
MOBILE
======================================== */

@media (max-width: 900px) {

  .nav-links a:not(.nav-cta) {
    display: none;
  }

  .intro-grid,
  .toronto-grid,
  .mobility-grid,
  .consultation-grid {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .city-pair,
  .niagara-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-grid > div:first-child {
    grid-column: 1 / -1;
  }
}


@media (max-width: 640px) {

  .container {
    width: calc(100% - 28px);
  }

  .nav {
    min-height: 76px;
  }

  .main-logo {
    width: 150px;
  }

  .nav-cta {
    padding: 10px 11px;
  }

  .hero {
    min-height: 850px;
  }

  .hero-inner {
    padding-top: 110px;
  }

  .hero-micro {
    grid-template-columns: repeat(2, 1fr);
  }

  .intro,
  .services,
  .toronto,
  .niagara,
  .mobility,
  .luxury-statement,
  .consultation {
    padding: 82px 0;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: 380px;
    padding: 28px;
  }

  .photo-feature {
    min-height: 600px;
  }

  .destination-feature {
    min-height: 590px;
  }

  .city-card {
    min-height: 550px;
  }

  .niagara-card {
    min-height: 520px;
  }

  .guyana {
    min-height: 780px;
  }

  .mobility-list {
    grid-template-columns: 1fr;
  }

  .form {
    padding: 27px 18px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .full {
    grid-column: auto;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid > div:first-child {
    grid-column: auto;
  }
}

</style>

</head>


